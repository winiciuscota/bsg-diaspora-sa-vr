#Messages		;! 12 total

$Command Sender: Theseus

$Name: O Orders
$Team: -1
$MessageNew:  XSTR("Red flight, a freighter, the Aurelia Dawn, is drifting dead beyond the Ravine and says she has survivors aboard. Escort the Raptor Lifeline in, let her take them off and bring her home. Keep your eyes open, this is too easy.", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-01.ogg

$Name: O Lifeline
$Team: -1
$MessageNew:  XSTR("Lifeline one, rolling. Aurelia Dawn, we're coming. Hold on out there.", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-02.ogg

$Name: O Dock
$Team: -1
$MessageNew:  XSTR("On station. No answer on the radio, but the beacon is strong. I'm opening the lock, give me ninety seconds.", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-03.ogg

$Name: O Empty
$Team: -1
$MessageNew:  XSTR("The ship is empty! No crew, no bodies, the beacon is a recording looped on a relay. It's a trap, get me out of here!", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-04.ogg

$Name: O Snare
$Team: -1
$MessageNew:  XSTR("Raiders jumping in on our six! They were waiting.", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-05.ogg

$Name: O Warden
$Team: -1
$MessageNew:  XSTR("DRADIS, basestar, bearing zero two zero! They baited the Raptor, Red flight, bring her home.", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-06.ogg

$Name: O Reactor
$Team: -1
$MessageNew:  XSTR("Red flight, the freighter's reactor is spooling up, the whole hull is rigged! Get clear!", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-07.ogg

$Name: O Win
$Team: -1
$MessageNew:  XSTR("Lifeline is back under the Theseus' guns. You smelled that trap before the Cylons finished laying it. Well done, Red flight.", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-08.ogg

$Name: O Lost
$Team: -1
$MessageNew:  XSTR("We lost Lifeline. Break off, Red flight.", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-09.ogg

$Name: More 1
$Team: -1
$MessageNew:  XSTR("A freighter alone. Dead in the water. This smells.", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-10.ogg

$Name: More 2
$Team: -1
$MessageNew:  XSTR("I'd feel better if there were a single survivor on the wideband.", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-11.ogg

$Name: More 3
$Team: -1
$MessageNew:  XSTR("Theseus to Red flight, the beacon is a recording. Remember that if they open fire.", -1)
$end_multi_text
+Wave Name: XM-OpenDoor-12.ogg

