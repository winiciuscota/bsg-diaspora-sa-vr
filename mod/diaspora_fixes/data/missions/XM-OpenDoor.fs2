#Command Briefing

#Briefing
$start_briefing
$num_stages: 1
$start_stage
$multi_text
 XSTR("A freighter drifts dead on the edge of the Ravine, her beacon calling for rescue. The Raptor Lifeline goes in to take off her crew and Red flight goes with her. Command doesn't like how quiet the sector is. Objectives. Escort Lifeline to the Aurelia Dawn. Get the Raptor away before the freighter blows and back to the fleet.", -1)
$end_multi_text
$voice: XM-OpenDoor-B-01.ogg
$camera_pos: 0.000000, 3000.000000, -9000.000000
$camera_orient:
	1.000000, 0.000000, 0.000000,
	0.000000, 0.939693, 0.342020,
	0.000000, -0.342020, 0.939693,
$camera_time: 500
$num_lines: 0
$num_icons: 0
$Flags: 1
$Formula: ( true ) 
$end_stage
$end_briefing

#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("An empty freighter, a looped beacon, a rigged reactor and a basestar waiting on the far side. The Raptor made it back.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("When a distress call is too perfect, keep the Raptor moving the moment it reports the ship is empty.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Lifeline Lost" 0 )
$Multi text
    XSTR("We lost the Raptor at the Aurelia Dawn.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Once the freighter is declared empty, clear 900 m before the reactor goes: about a minute after the Raptor leaves.", -1)
$end_multi_text

