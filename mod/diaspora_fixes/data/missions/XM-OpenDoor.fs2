#Events		;! 22 total

$Formula: ( when ( true ) ( ship-guardian-threshold 25 "Lifeline 1" ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 2 ) ( send-message "#Command" "High" "O Orders" ) )
+Name: Say O Orders
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 14 ) ( not ( is-destroyed-delay 0 "Lifeline 1" ) ) ) ( send-message "Lifeline 1" "High" "O Lifeline" ) )
+Name: Say O Lifeline
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( < ( distance "Lifeline 1" "Aurelia Dawn" ) 700 ) ( do-nothing ) )
+Name: Dock Wait
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Dock Wait" 2 ) ( not ( is-destroyed-delay 0 "Lifeline 1" ) ) ) ( send-message "Lifeline 1" "High" "O Dock" ) )
+Name: Say O Dock
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Dock Wait" 20 ) ( not ( is-destroyed-delay 0 "Lifeline 1" ) ) ) ( send-message "Lifeline 1" "High" "O Empty" ) )
+Name: Say O Empty
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Dock Wait" 22 ) ( add-goal "Lifeline 1" ( ai-waypoints-once "Home" 90 ) ) )
+Name: Leave
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Dock Wait" 30 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "O Snare" ) )
+Name: Say O Snare
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Dock Wait" 55 ) ( send-message "#Command" "High" "O Warden" ) )
+Name: Say O Warden
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Dock Wait" 62 ) ( not ( is-destroyed-delay 0 "Lifeline 1" ) ) ) ( send-message "Lifeline 1" "High" "O Reactor" ) )
+Name: Say O Reactor
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Dock Wait" 90 ) ( < ( distance "Lifeline 1" "Aurelia Dawn" ) 900 ) ) ( destroy-instantly "Lifeline 1" ) )
+Name: Blast Check
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Dock Wait" 90 ) ( destroy-instantly "Aurelia Dawn" ) )
+Name: Blast
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Blast" 40 ) ( < ( distance "Lifeline 1" "Red 1" ) 3000 ) ( percent-ships-destroyed 50 "Snare" ) ( percent-ships-destroyed 50 "Jaw" ) ( percent-ships-destroyed 50 "Tail" ) ) ( do-nothing ) )
+Name: Clear
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Clear" 40 ) ( send-message "#Command" "High" "O Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Lifeline 1" ) ( send-message "#Command" "High" "O Lost" ) )
+Name: Lifeline Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Lifeline Lost" 8 ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 70 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "More 1" ) )
+Name: More 1 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 150 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "More 2" ) )
+Name: More 2 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 230 ) ( send-message "#Command" "Normal" "More 3" ) )
+Name: More 3 Msg
+Repeat Count: 1
+Interval: 1

