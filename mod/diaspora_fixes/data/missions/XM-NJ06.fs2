#Events		;! 20 total

$Formula: ( when ( true ) ( do-nothing ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 3 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "L1 NJ06" ) )
+Name: Say L1 NJ06
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 110 ) ( not ( is-destroyed-delay 0 "Nightjar 2" ) ) ) ( send-message "Nightjar 2" "High" "L2 NJ06" ) )
+Name: Say L2 NJ06
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 265 ) ( not ( is-destroyed-delay 0 "Nightjar 3" ) ) ) ( send-message "Nightjar 3" "High" "L3 NJ06" ) )
+Name: Say L3 NJ06
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 430 ) ( not ( is-destroyed-delay 0 "Nightjar 2" ) ) ) ( send-message "Nightjar 2" "High" "L4 NJ06" ) )
+Name: Say L4 NJ06
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 600 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "L5 NJ06" ) )
+Name: Say L5 NJ06
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 720 ) ( not ( is-destroyed-delay 0 "Nightjar 3" ) ) ) ( send-message "Nightjar 3" "High" "L6 NJ06" ) )
+Name: Say L6 NJ06
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( < ( distance "Wolf A 1" "Marker" ) 2400 ) ( do-nothing ) )
+Name: Spring
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Spring" 1 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "Spring NJ06" ) )
+Name: Say Spring NJ06
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( percent-ships-destroyed 100 "Wolf A" ) ( percent-ships-destroyed 100 "Wolf B" ) ( percent-ships-destroyed 100 "Wolf C" ) ) ( do-nothing ) )
+Name: Cleared
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Cleared" 2 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "Clear NJ06" ) )
+Name: Say Clear NJ06
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Cleared" 0 ) ( > ( distance "Nightjar 1" "Marker" ) 4500 ) ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Cond" 0 ) ( send-message "#Command" "High" "W NJ06" ) )
+Name: Win Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Msg" 3 ) ( do-nothing ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Nightjar 1" ) ( send-message "#Command" "High" "F NJ06" ) )
+Name: Lead Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 1000 ) ( send-message "#Command" "High" "F NJ06" ) )
+Name: Too Late
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Lead Lost" 8 ) ( is-event-true-delay "Too Late" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

