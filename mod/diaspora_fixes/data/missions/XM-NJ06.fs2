$Command Sender: Theseus

$Name: L1 NJ06
$Team: -1
$MessageNew:  XSTR("Nightjars, three patrols are due, ten minutes between them. Take them one at a time, hide between.", -1)
$end_multi_text
+Wave Name: XM-NJ06-01.ogg

$Name: L2 NJ06
$Team: -1
$MessageNew:  XSTR("First patrol on DRADIS. Four Raiders.", -1)
$end_multi_text
+Wave Name: XM-NJ06-02.ogg

$Name: L3 NJ06
$Team: -1
$MessageNew:  XSTR("Second patrol. They didn't see the wreckage of the first. Good.", -1)
$end_multi_text
+Wave Name: XM-NJ06-03.ogg

$Name: L4 NJ06
$Team: -1
$MessageNew:  XSTR("Advanced Raiders. They'll turn tight.", -1)
$end_multi_text
+Wave Name: XM-NJ06-04.ogg

$Name: L5 NJ06
$Team: -1
$MessageNew:  XSTR("Patrol is late back. They'll send someone to look. Move.", -1)
$end_multi_text
+Wave Name: XM-NJ06-05.ogg

$Name: L6 NJ06
$Team: -1
$MessageNew:  XSTR("A wolf pack hunts best at night.", -1)
$end_multi_text
+Wave Name: XM-NJ06-06.ogg

$Name: Spring NJ06
$Team: -1
$MessageNew:  XSTR("First blood. Weapons free.", -1)
$end_multi_text
+Wave Name: XM-NJ06-07.ogg

$Name: Clear NJ06
$Team: -1
$MessageNew:  XSTR("That's all of them. Break contact, Nightjars, back to the rocks before the next one comes looking.", -1)
$end_multi_text
+Wave Name: XM-NJ06-08.ogg

$Name: W NJ06
$Team: -1
$MessageNew:  XSTR("Three patrols, no survivors. The Cylons are blind in this sector tonight.", -1)
$end_multi_text
+Wave Name: XM-NJ06-09.ogg

$Name: F NJ06
$Team: -1
$MessageNew:  XSTR("One of the patrols got away and called it in.", -1)
$end_multi_text
