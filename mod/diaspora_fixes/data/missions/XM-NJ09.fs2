#Messages		;! 10 total

$Command Sender: Theseus

$Name: L1 NJ09
$Team: -1
$MessageNew:  XSTR("Nightjars, the biggest target we've had. Four Movers and a heavy escort. Everything in the cell hits it at once.", -1)
$end_multi_text
+Wave Name: XM-NJ09-01.ogg

$Name: L2 NJ09
$Team: -1
$MessageNew:  XSTR("Let it come to us. Sit still.", -1)
$end_multi_text
+Wave Name: XM-NJ09-02.ogg

$Name: L3 NJ09
$Team: -1
$MessageNew:  XSTR("Convoy on DRADIS. Biggest I've seen.", -1)
$end_multi_text
+Wave Name: XM-NJ09-03.ogg

$Name: L4 NJ09
$Team: -1
$MessageNew:  XSTR("Movers first, they carry the payload.", -1)
$end_multi_text
+Wave Name: XM-NJ09-04.ogg

$Name: L5 NJ09
$Team: -1
$MessageNew:  XSTR("Advanced Raiders from the nearest picket. Move fast.", -1)
$end_multi_text
+Wave Name: XM-NJ09-05.ogg

$Name: L6 NJ09
$Team: -1
$MessageNew:  XSTR("That's the offensive, gone.", -1)
$end_multi_text
+Wave Name: XM-NJ09-06.ogg

$Name: Spring NJ09
$Team: -1
$MessageNew:  XSTR("Now! Everything at once!", -1)
$end_multi_text
+Wave Name: XM-NJ09-07.ogg

$Name: Clear NJ09
$Team: -1
$MessageNew:  XSTR("That's all of them. Break contact, Nightjars, back to the rocks before the next one comes looking.", -1)
$end_multi_text
+Wave Name: XM-NJ09-08.ogg

$Name: W NJ09
$Team: -1
$MessageNew:  XSTR("The convoy is gone and the Cylon offensive with it. Fine work, Nightjars.", -1)
$end_multi_text
+Wave Name: XM-NJ09-09.ogg

$Name: F NJ09
$Team: -1
$MessageNew:  XSTR("The convoy got through.", -1)
$end_multi_text
+Wave Name: XM-NJ09-10.ogg

