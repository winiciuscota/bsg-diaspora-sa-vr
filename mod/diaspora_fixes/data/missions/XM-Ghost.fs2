#Briefing
$start_briefing
$num_stages: 1
$start_stage
$multi_text
 XSTR("The Halyard keeps getting painted by something DRADIS cannot see. A stealthed Advanced Raider is shadowing her and reporting her position. Red flight has to find it by eye and kill it before it calls the basestar. Objectives. Destroy the stealthed Advanced Raider before it calls the basestar. The Halyard must survive.", -1)
$end_multi_text
$voice: XM-Ghost-B-01.ogg
$camera_pos: 0.000000, 3000.000000, -9000.000000
$camera_orient:
	1.000000, 0.000000, 0.000000,
	0.000000, 0.939693, 0.342020,
	0.000000, -0.342020, 0.939693,
$camera_time: 500
$num_lines: 0
$num_icons: 0
$Flags: 1
$Formula: ( true ) 
$end_stage
$end_briefing

#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("The scout is wreckage and its report never left the system. The Halyard is safe for now.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Stealth hides a ship from DRADIS, not from your eyes. Look for the engine glow.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Halyard Lost" 0 )
$Multi text
    XSTR("We lost the Halyard. The scout was too well hidden.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Circle the Halyard at a wide radius and watch the stars for engine glow, the scout stays close to her hull.", -1)
$end_multi_text

