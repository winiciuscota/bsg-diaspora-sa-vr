#Goals		;! 2 total

$Type: Primary
+Name: Find the scout
$MessageNew:  XSTR("Destroy the stealthed Advanced Raider before it calls the basestar", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Primary
+Name: Keep the Halyard
$MessageNew:  XSTR("The Halyard must survive", -1)
$end_multi_text
$Formula: ( and ( is-event-true-delay "Win" 0 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) )
+Score: 50

#Waypoints		;! 0 lists total

#Messages		;! 12 total

$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("Red flight, the Halyard says something is painting her and DRADIS shows nothing. A stealthed scout is shadowing her. Find it by eye, you have three minutes before it reports her position.", -1)
$end_multi_text
+Wave Name: XM-Ghost-01.ogg

$Name: Halyard Hail
$Team: -1
$MessageNew:  XSTR("Halyard here. Every few seconds I feel it, a little flicker on our hull. Look for engine glow, Red leader.", -1)
$end_multi_text
+Wave Name: XM-Ghost-02.ogg

$Name: Hint One
$Team: -1
$MessageNew:  XSTR("Nothing on DRADIS. It has to be close. Look for the engine glow against the stars.", -1)
$end_multi_text
+Wave Name: XM-Ghost-03.ogg

$Name: Hint Two
$Team: -1
$MessageNew:  XSTR("Sixty seconds. If it calls home, we'll have a basestar on us.", -1)
$end_multi_text
+Wave Name: XM-Ghost-04.ogg

$Name: Wraith Found
$Team: -1
$MessageNew:  XSTR("Got it! There, low and to port of the Halyard. It's turning away.", -1)
$end_multi_text

$Name: HQ Win
$Team: -1
$MessageNew:  XSTR("The scout is down and nothing reached the basestar. The Halyard can stop flinching now. Well done.", -1)
$end_multi_text
+Wave Name: XM-Ghost-05.ogg

$Name: Called Home
$Team: -1
$MessageNew:  XSTR("It jumped a message out. DRADIS, basestar, inbound! Halyard, spool your FTL!", -1)
$end_multi_text
+Wave Name: XM-Ghost-06.ogg

$Name: HQ Halyard Lost
$Team: -1
$MessageNew:  XSTR("The Halyard is gone. Break off, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Ghost-07.ogg

$Name: More 1
$Team: -1
$MessageNew:  XSTR("A ghost light. Fleet superstition says it's a bad omen.", -1)
$end_multi_text
+Wave Name: XM-Ghost-08.ogg

$Name: More 2
$Team: -1
$MessageNew:  XSTR("I don't believe in ghosts. I do believe in Raiders.", -1)
$end_multi_text
+Wave Name: XM-Ghost-09.ogg

$Name: More 3
$Team: -1
$MessageNew:  XSTR("Halyard to Red flight, whatever's out there is not on DRADIS. Trust your eyes.", -1)
$end_multi_text
+Wave Name: XM-Ghost-10.ogg

$Name: More 4
$Team: -1
$MessageNew:  XSTR("Theseus to Red flight, if it looks like a ghost, shoot it twice.", -1)
$end_multi_text
+Wave Name: XM-Ghost-11.ogg

