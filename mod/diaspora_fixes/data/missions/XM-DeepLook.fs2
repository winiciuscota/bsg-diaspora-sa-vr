#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("The scan shows the basestar was refitting its raider bays. Theseus is warning the whole fleet. That was a Raptor crew's job done the way it should be done.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("A Raptor is slow and has no shields. Let the Vipers fight, keep moving and use countermeasures.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Lantern Lost" 0 )
$Multi text
    XSTR("Lantern 1 never came back. Whatever was on that basestar stays a mystery.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Once the scan is done, turn away from the basestar at full speed and stay near your escorts.", -1)
$end_multi_text

#Callsigns:
$Callsign: Shadow
$Callsign: Flask

#end


