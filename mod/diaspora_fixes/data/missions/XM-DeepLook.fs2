$Formula: ( when ( is-cargo-known-delay 0 "Hecate" ) ( send-message "Red 1" "High" "Scan Done" ) )
+Name: Waking
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Waking" 3 ) ( turret-free-all "Hecate" ) )
+Name: Turrets Free
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 2 "Wake" ) ( send-message "Red 2" "High" "S Wake" ) )
+Name: Wake Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Waking" 12 ) ( send-message "#Command" "High" "HQ Run" ) )
+Name: Run Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Fury" ) ( send-message "Red 3" "High" "F Fury" ) )
+Name: Fury Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Waking" 75 ) ( send-message "#Command" "High" "HQ Jump" ) )
+Name: Jump Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Jump Msg" 6 ) ( send-message "#Command" "High" "HQ Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Red 1" ) ( send-message "#Command" "High" "HQ Lost" ) )
+Name: Lantern Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Lantern Lost" 8 ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Shadow Msg" 12 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 1" ) )
+Name: Chatter 1 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Shadow Msg" 22 ) ( not ( is-destroyed-delay 0 "Red 1" ) ) ) ( send-message "Red 1" "Normal" "Chatter 2" ) )
+Name: Chatter 2 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Close Msg" 8 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 3" ) )
+Name: Chatter 3 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Waking" 7 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 4" ) )
+Name: Chatter 4 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Run Msg" 14 ) ( not ( is-destroyed-delay 0 "Red 1" ) ) ) ( send-message "Red 1" "Normal" "Chatter 5" ) )
+Name: Chatter 5 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Fury Msg" 16 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 6" ) )
+Name: Chatter 6 Msg
+Repeat Count: 1
+Interval: 1

#Goals		;! 3 total

$Type: Primary
+Name: Scan the basestar
$MessageNew:  XSTR("Fly the Raptor into scanning range and scan the basestar Hecate", -1)
$end_multi_text
$Formula: ( is-cargo-known-delay 0 "Hecate" )
+Score: 100

$Type: Primary
+Name: Bring the data home
$MessageNew:  XSTR("Survive until the jump", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Bonus
+Name: Escort's pride
$MessageNew:  XSTR("Shadow and Flask both make it home", -1)
$end_multi_text
$Formula: ( and ( is-event-true-delay "Win" 0 ) ( not ( is-destroyed-delay 0 "Red 2" "Red 3" ) ) )
+Score: 30

#Waypoints		;! 0 lists total

#Messages		;! 16 total

$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("Lantern 1, Theseus. That basestar hasn't moved in six hours. Get within scanning range, target it and hold steady until your DRADIS has the scan. Then turn around and stay alive. Don't fire on it.", -1)
$end_multi_text
+Wave Name: XM-DeepLook-01.ogg

$Name: Shadow Hail
$Team: -1
$MessageNew:  XSTR("Shadow and Flask on your wing, Lantern. You do the looking, we'll do the shooting.", -1)
$end_multi_text
+Wave Name: XM-DeepLook-02.ogg

$Name: F Close
$Team: -1
$MessageNew:  XSTR("Getting close now. Gods, it's big. Nothing moving on the hull.", -1)
$end_multi_text
+Wave Name: XM-DeepLook-03.ogg

$Name: Scan Done
$Team: -1
$MessageNew:  XSTR("Scan complete! I've got their whole... wait. It's powering up. It's powering up!", -1)
$end_multi_text
+Wave Name: XM-DeepLook-04.ogg

$Name: S Wake
$Team: -1
$MessageNew:  XSTR("Raiders launching, they're coming for the Raptor! Lantern, get your nose pointed home!", -1)
$end_multi_text
+Wave Name: XM-DeepLook-05.ogg

$Name: HQ Run
$Team: -1
$MessageNew:  XSTR("Lantern 1, we have your data. Stay alive for one more minute while we plot your jump.", -1)
$end_multi_text
+Wave Name: XM-DeepLook-06.ogg

$Name: F Fury
$Team: -1
$MessageNew:  XSTR("Advanced models! I can't keep them all off you, Lantern!", -1)
$end_multi_text
+Wave Name: XM-DeepLook-07.ogg

$Name: HQ Jump
$Team: -1
$MessageNew:  XSTR("Jump solution sent. Everyone out, now!", -1)
$end_multi_text
+Wave Name: XM-DeepLook-08.ogg

$Name: HQ Win
$Team: -1
$MessageNew:  XSTR("Lantern 1 is home and that data is pure gold. Good flying, all of you.", -1)
$end_multi_text
+Wave Name: XM-DeepLook-09.ogg

$Name: HQ Lost
$Team: -1
$MessageNew:  XSTR("We've lost Lantern 1 and the scan with her. Shadow, Flask, come home.", -1)
$end_multi_text
+Wave Name: XM-DeepLook-10.ogg

$Name: Chatter 1
$Team: -1
$MessageNew:  XSTR("Flask here. First time I've ever escorted somebody toward a basestar on purpose.", -1)
$end_multi_text
+Wave Name: XM-DeepLook-11.ogg

$Name: Chatter 2
$Team: -1
$MessageNew:  XSTR("Just keep the toasters off me and let me get my pictures.", -1)
$end_multi_text
+Wave Name: XM-DeepLook-12.ogg

$Name: Chatter 3
$Team: -1
$MessageNew:  XSTR("Look at the hull. It's like it's breathing.", -1)
$end_multi_text
+Wave Name: XM-DeepLook-13.ogg

$Name: Chatter 4
$Team: -1
$MessageNew:  XSTR("Lantern, burn! Don't look back, just burn!", -1)
$end_multi_text
+Wave Name: XM-DeepLook-14.ogg

$Name: Chatter 5
$Team: -1
$MessageNew:  XSTR("I've got two on my tail! Shadow, Flask, anyone!", -1)
$end_multi_text
+Wave Name: XM-DeepLook-15.ogg

$Name: Chatter 6
$Team: -1
$MessageNew:  XSTR("Got him! Lantern, you're clear on the left, keep moving!", -1)
$end_multi_text
+Wave Name: XM-DeepLook-16.ogg

