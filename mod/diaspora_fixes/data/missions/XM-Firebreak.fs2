#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Theseus jumped with her whole air group aboard and the Cylons got nothing but wreckage. The engineers bought four minutes and you made them count.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Heavy Raiders carry torpedoes. They come in from the flank while the Raiders keep you busy.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Theseus Lost" 0 )
$Multi text
    XSTR("Theseus is gone. That should not be possible, and yet here we are.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Stay near the battlestar. The torpedo carriers are the only real threat to her.", -1)
$end_multi_text

