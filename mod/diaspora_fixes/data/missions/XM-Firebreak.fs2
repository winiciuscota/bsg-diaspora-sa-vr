#Messages		;! 20 total

$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("All Vipers, Theseus Actual. Our FTL is down for four minutes. Raiders are inbound. Red and Blue flights, you are the firebreak. Nothing gets to this ship.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-01.ogg

$Name: Ghost Hail
$Team: -1
$MessageNew:  XSTR("Ghost here. Blue flight takes the left side, Red Leader. Let's make this quick.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-02.ogg

$Name: S Embers
$Team: -1
$MessageNew:  XSTR("First wave, dead ahead! Four Raiders.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-03.ogg

$Name: HQ Cinder
$Team: -1
$MessageNew:  XSTR("Heavy Raiders with torpedoes on the starboard approach. Kill them before they launch!", -1)
$end_multi_text
+Wave Name: XM-Firebreak-04.ogg

$Name: F Soot
$Team: -1
$MessageNew:  XSTR("And their escorts on the port side. Blue flight, you've got company.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-05.ogg

$Name: HQ Basestar
$Team: -1
$MessageNew:  XSTR("DRADIS contact, basestar! Ten kilometres and closing. Engineering, I need that FTL!", -1)
$end_multi_text
+Wave Name: XM-Firebreak-06.ogg

$Name: S Slag
$Team: -1
$MessageNew:  XSTR("It's launching more Raiders. Hold the line, Thunderlords!", -1)
$end_multi_text
+Wave Name: XM-Firebreak-07.ogg

$Name: HQ FTL
$Team: -1
$MessageNew:  XSTR("FTL is green. All Vipers, we jump in twelve seconds. Get clear of the hull!", -1)
$end_multi_text
+Wave Name: XM-Firebreak-08.ogg

$Name: HQ Win
$Team: -1
$MessageNew:  XSTR("Jump complete. Theseus is clear and every Viper came with us. That was a firebreak, people.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-09.ogg

$Name: HQ Lost
$Team: -1
$MessageNew:  XSTR("Theseus is breaking up. All Vipers, scatter and jump to the fleet rendezvous.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-10.ogg

$Name: Chatter 1
$Team: -1
$MessageNew:  XSTR("Rook here. Four minutes. I've had longer showers.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-11.ogg

$Name: Chatter 2
$Team: -1
$MessageNew:  XSTR("Splash one! They're coming in pairs, watch your wingman.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-12.ogg

$Name: Chatter 3
$Team: -1
$MessageNew:  XSTR("Ghost to Red, I'm on the Heavy at the bottom. Take the top two.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-13.ogg

$Name: Chatter 4
$Team: -1
$MessageNew:  XSTR("Damage control reports minor hull breach on deck seven. Keep them off us, pilots.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-14.ogg

$Name: Chatter 5
$Team: -1
$MessageNew:  XSTR("A basestar. Of course there's a basestar.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-15.ogg

$Name: Chatter 6
$Team: -1
$MessageNew:  XSTR("Rook to all Vipers, last one to the hangar buys the drinks.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-16.ogg

$Name: More 1
$Team: -1
$MessageNew:  XSTR("Fire on the line. I'd rather it be fuel than us.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-17.ogg

$Name: More 2
$Team: -1
$MessageNew:  XSTR("Burn them back before they reach the tankers, that's all there is to it.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-18.ogg

$Name: More 3
$Team: -1
$MessageNew:  XSTR("Theseus to Red flight, hold the firebreak. Nothing gets past you.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-19.ogg

$Name: More 4
$Team: -1
$MessageNew:  XSTR("If we win this one, the deck crew owes us a week of coffee.", -1)
$end_multi_text
+Wave Name: XM-Firebreak-20.ogg

