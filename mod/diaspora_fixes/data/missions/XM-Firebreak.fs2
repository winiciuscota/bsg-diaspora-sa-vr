$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Secondary
+Name: Stop the torpedo runs
$MessageNew:  XSTR("Destroy the Heavy Raiders", -1)
$end_multi_text
$Formula: ( is-destroyed-delay 0 "Cinder 1" "Cinder 2" "Cinder 3" )
+Score: 50

$Type: Bonus
+Name: Firebreak
$MessageNew:  XSTR("Destroy most of the Raiders", -1)
$end_multi_text
$Formula: ( percent-ships-destroyed 75 "Ember" "Soot" "Slag" )
+Score: 30

