#Command Briefing

#Briefing
$start_briefing
$num_stages: 1
$start_stage
$multi_text
 XSTR("A Cylon missile cracked Theseus' FTL coolant lines during the last jump. Engineering needs four minutes to bypass them, and the Cylons have found us. Red and Blue flights hold the line until the battlestar can jump. Objectives. Hold the line until Theseus jumps.", -1)
$end_multi_text
$voice: XM-Firebreak-B-01.ogg
$camera_pos: 0.000000, 3000.000000, -9000.000000
