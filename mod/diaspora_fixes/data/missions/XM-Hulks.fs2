#Events		;! 35 total

$Formula: ( when ( true ) ( ship-guardian-threshold 25 "Lantern 1" ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 2 ) ( send-message "#Command" "High" "D Orders" ) )
+Name: Say D Orders
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 14 ) ( not ( is-destroyed-delay 0 "Lantern 1" ) ) ) ( send-message "Lantern 1" "High" "D Lantern" ) )
+Name: Say D Lantern
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 600 ) ( do-nothing ) )
+Name: Blue Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( < ( distance "Lantern 1" "Hulk A" ) 650 ) ( do-nothing ) )
+Name: Site 1 Wait
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Site 1 Wait" 260 ) ( do-nothing ) )
+Name: Site 1 Done
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( < ( distance "Lantern 1" "Hulk B" ) 650 ) ( do-nothing ) )
+Name: Site 2 Wait
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Site 2 Wait" 280 ) ( do-nothing ) )
+Name: Site 2 Done
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( < ( distance "Lantern 1" "Hulk C" ) 650 ) ( do-nothing ) )
+Name: Site 3 Wait
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Site 3 Wait" 300 ) ( do-nothing ) )
+Name: Site 3 Done
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( < ( distance "Lantern 1" "Hulk D" ) 650 ) ( do-nothing ) )
+Name: Site 4 Wait
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Site 4 Wait" 320 ) ( do-nothing ) )
+Name: Site 4 Done
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 1 Wait" 2 ) ( not ( is-destroyed-delay 0 "Lantern 1" ) ) ) ( send-message "Lantern 1" "High" "D Site 1" ) )
+Name: Say D Site 1
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 1 Done" 2 ) ( not ( is-destroyed-delay 0 "Lantern 1" ) ) ) ( send-message "Lantern 1" "High" "D Site 1 Done" ) )
+Name: Say D Site 1 Done
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Site 1 Done" 10 ) ( add-goal "Lantern 1" ( ai-waypoints-once "Leg 2" 60 ) ) )
+Name: Leg 2 Go
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 1 Done" 14 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "D Gleaner" ) )
+Name: Say D Gleaner
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 2 Wait" 3 ) ( not ( is-destroyed-delay 0 "Lantern 1" ) ) ) ( send-message "Lantern 1" "High" "D Site 2" ) )
+Name: Say D Site 2
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 2 Wait" 45 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "D Reaper" ) )
+Name: Say D Reaper
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 2 Done" 2 ) ( not ( is-destroyed-delay 0 "Lantern 1" ) ) ) ( send-message "Lantern 1" "High" "D Site 2 Done" ) )
+Name: Say D Site 2 Done
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Site 2 Done" 10 ) ( add-goal "Lantern 1" ( ai-waypoints-once "Leg 3" 60 ) ) )
+Name: Leg 3 Go
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 3 Wait" 3 ) ( not ( is-destroyed-delay 0 "Lantern 1" ) ) ) ( send-message "Lantern 1" "High" "D Site 3" ) )
+Name: Say D Site 3
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 3 Wait" 35 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "D Stalk" ) )
+Name: Say D Stalk
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 3 Done" 2 ) ( not ( is-destroyed-delay 0 "Lantern 1" ) ) ) ( send-message "Lantern 1" "High" "D Site 3 Done" ) )
+Name: Say D Site 3 Done
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Site 3 Done" 10 ) ( add-goal "Lantern 1" ( ai-waypoints-once "Leg 4" 60 ) ) )
+Name: Leg 4 Go
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 4 Wait" 3 ) ( not ( is-destroyed-delay 0 "Lantern 1" ) ) ) ( send-message "Lantern 1" "High" "D Site 4" ) )
+Name: Say D Site 4
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Site 4 Wait" 65 ) ( send-message "#Command" "High" "D Basestar" ) )
+Name: Say D Basestar
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 4 Done" 2 ) ( not ( is-destroyed-delay 0 "Lantern 1" ) ) ) ( send-message "Lantern 1" "High" "D Site 4 Done" ) )
+Name: Say D Site 4 Done
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Site 4 Done" 10 ) ( add-goal "Lantern 1" ( ai-waypoints-once "Home" 80 ) ) )
+Name: Go Home
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Site 4 Done" 30 ) ( < ( distance "Lantern 1" "Red 1" ) 3000 ) ( percent-ships-destroyed 50 "Scavs" ) ) ( do-nothing ) )
+Name: Home Reached
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Home Reached" 120 ) ( send-message "#Command" "High" "D Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Lantern 1" ) ( send-message "#Command" "High" "D Lost" ) )
+Name: Lantern Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Lantern Lost" 8 ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

