$Type: Primary
+Name: Survey the four hulks
$MessageNew:  XSTR("Stay with Lantern until all four wrecks are downloaded", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Site 4 Done" 0 )
+Score: 100

$Type: Primary
+Name: Bring Lantern home
$MessageNew:  XSTR("Get the Raptor out of the belt alive", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
