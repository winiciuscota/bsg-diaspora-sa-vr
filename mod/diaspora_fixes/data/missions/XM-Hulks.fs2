$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Four wrecks, four black boxes and a basestar that tried to follow us home. The analysts will be busy for weeks.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("The Raptor is slow and unarmed, always fly between it and the Raiders.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Lantern Lost" 0 )
$Multi text
    XSTR("We lost the Raptor and her data in the belt.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Stay within a kilometre of Lantern at every wreck, the Heavies come on a timer.", -1)
$end_multi_text

