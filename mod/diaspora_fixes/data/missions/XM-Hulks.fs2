#Messages		;! 16 total

$Command Sender: Theseus

$Name: D Orders
$Team: -1
$MessageNew:  XSTR("Red flight, escort the Raptor Lantern through four wrecks in the Perihelion belt. She needs several minutes at each to download the black boxes. Keep her alive and keep her within the survey range of every hulk.", -1)
$end_multi_text
+Wave Name: XM-Hulks-01.ogg

$Name: D Lantern
$Team: -1
$MessageNew:  XSTR("Lantern one, ready to start. I'll tell you the moment a site is done. Stay close, I'm unarmed.", -1)
$end_multi_text
+Wave Name: XM-Hulks-02.ogg

$Name: D Site 1
$Team: -1
$MessageNew:  XSTR("At the first hulk. Download started, about four minutes. Please don't let anything near me.", -1)
$end_multi_text
+Wave Name: XM-Hulks-03.ogg

$Name: D Site 1 Done
$Team: -1
$MessageNew:  XSTR("First box is clean. Moving to the second wreck. Red flight, stay with me.", -1)
$end_multi_text
+Wave Name: XM-Hulks-04.ogg

$Name: D Gleaner
$Team: -1
$MessageNew:  XSTR("Four Raiders from the belt, scavengers. They smell the Raptor.", -1)
$end_multi_text
+Wave Name: XM-Hulks-05.ogg

$Name: D Site 2
$Team: -1
$MessageNew:  XSTR("Second wreck. This one has damaged memory, it'll take longer. Hold the line.", -1)
$end_multi_text
+Wave Name: XM-Hulks-06.ogg

$Name: D Reaper
$Team: -1
$MessageNew:  XSTR("Heavy Raiders from the high side! They're targeting Lantern!", -1)
$end_multi_text
+Wave Name: XM-Hulks-07.ogg

$Name: D Site 2 Done
$Team: -1
$MessageNew:  XSTR("Second wreck done. On to number three. This is not a quiet belt.", -1)
$end_multi_text
+Wave Name: XM-Hulks-08.ogg

$Name: D Site 3
$Team: -1
$MessageNew:  XSTR("Third wreck, a transport. There's a lot of data in this one, five minutes.", -1)
$end_multi_text
+Wave Name: XM-Hulks-09.ogg

$Name: D Stalk
$Team: -1
$MessageNew:  XSTR("Advanced Raiders, circling low. They're fast, don't let them get inside!", -1)
$end_multi_text
+Wave Name: XM-Hulks-10.ogg

$Name: D Site 3 Done
$Team: -1
$MessageNew:  XSTR("Third done. Last one is the big hulk. Almost there.", -1)
$end_multi_text
+Wave Name: XM-Hulks-11.ogg

$Name: D Site 4
$Team: -1
$MessageNew:  XSTR("Last wreck, the flagship's bridge. Six minutes. I'm sorry, it's the one that matters.", -1)
$end_multi_text
+Wave Name: XM-Hulks-12.ogg

$Name: D Basestar
$Team: -1
$MessageNew:  XSTR("DRADIS, basestar, bearing zero four zero! A hunting group has followed the Raptor.", -1)
$end_multi_text
+Wave Name: XM-Hulks-13.ogg

$Name: D Site 4 Done
$Team: -1
$MessageNew:  XSTR("Got everything! Heading home now. Cover me, Red flight, this part is not over.", -1)
$end_multi_text
+Wave Name: XM-Hulks-14.ogg

$Name: D Win
$Team: -1
