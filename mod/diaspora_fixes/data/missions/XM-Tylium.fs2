#Events		;! 25 total

$Formula: ( when ( true ) ( ship-guardian-threshold 20 "Cassia" ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 3 ) ( send-message "#Command" "High" "HQ Orders" ) )
+Name: Orders Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Orders Msg" 16 ) ( send-message "Cassia" "High" "Cassia Hail" ) )
+Name: Cassia Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Cassia Msg" 10 ) ( do-nothing ) )
+Name: Jackal Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Jackal" ) ( send-message "Red 2" "High" "S Jackals" ) )
+Name: Jackal Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Jackal Cue" 70 ) ( do-nothing ) )
+Name: Hound Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Hound" ) ( send-message "Red 3" "High" "F Hounds" ) )
+Name: Hound Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 12 "Hound" ) ( send-message "Halyard" "High" "Halyard Flak" ) )
+Name: Halyard Msg
+Repeat Count: 1
