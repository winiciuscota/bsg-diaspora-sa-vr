$Formula: ( when ( is-event-true-delay "Hound Cue" 75 ) ( do-nothing ) )
+Name: Mauler Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Mauler" ) ( send-message "Red 2" "High" "S Maulers" ) )
+Name: Mauler Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Mauler Cue" 20 ) ( ship-no-guardian "Cassia" ) )
+Name: Guard Off
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Mauler Cue" 80 ) ( send-message "Cassia" "High" "Cassia Spool" ) )
+Name: Convoy Jump
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-departed-delay 3 "Cassia" ) ( send-message "#Command" "High" "HQ Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Cassia" ) ( send-message "#Command" "High" "HQ Cassia Lost" ) )
+Name: Cassia Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Hesper" ) ( send-message "#Command" "High" "HQ Hesper Lost" ) )
+Name: Hesper Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Cassia Lost" 8 ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Cassia Msg" 8 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 1" ) )
+Name: Chatter 1 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Cassia Msg" 16 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 2" ) )
+Name: Chatter 2 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Jackal Msg" 25 ) ( not ( is-destroyed-delay 0 "Cassia" ) ) ) ( send-message "Cassia" "Normal" "Chatter 3" ) )
+Name: Chatter 3 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Hound Msg" 20 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 4" ) )
+Name: Chatter 4 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Mauler Msg" 12 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "Normal" "Chatter 5" ) )
+Name: Chatter 5 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Convoy Jump" 4 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 6" ) )
+Name: Chatter 6 Msg
+Repeat Count: 1
+Interval: 1

#Goals		;! 3 total

$Type: Primary
+Name: Protect Cassia
$MessageNew:  XSTR("Get the tanker Cassia to the jump point", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Secondary
+Name: Protect Hesper
$MessageNew:  XSTR("Keep the freighter Hesper alive", -1)
$end_multi_text
$Formula: ( has-departed-delay 0 "Hesper" )
+Score: 50

$Type: Bonus
+Name: Stop the Maulers
$MessageNew:  XSTR("Destroy both Heavy Raiders", -1)
$end_multi_text
$Formula: ( is-destroyed-delay 0 "Mauler 1" "Mauler 2" )
+Score: 30

