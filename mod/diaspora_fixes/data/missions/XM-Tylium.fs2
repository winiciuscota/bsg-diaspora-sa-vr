#Messages		;! 16 total

$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("Red flight, Theseus. The tanker Cassia and the freighter Hesper are carrying every drop of tylium the Ragnar refinery could give us. Get them to the jump point. The fleet runs dry in four days without that fuel.", -1)
$end_multi_text
+Wave Name: XM-Tylium-01.ogg

$Name: Cassia Hail
$Team: -1
$MessageNew:  XSTR("Red Leader, Cassia. We're heavy and we're slow, so don't wander off. Halyard has our backs, but she can't turn fast enough to catch a Raider.", -1)
$end_multi_text
+Wave Name: XM-Tylium-02.ogg

$Name: S Jackals
$Team: -1
$MessageNew:  XSTR("Raiders, three o'clock low! Four of them, going straight for the tanker.", -1)
$end_multi_text
+Wave Name: XM-Tylium-03.ogg

$Name: F Hounds
$Team: -1
$MessageNew:  XSTR("More coming in on the left. Advanced models. They're faster than us on the straight.", -1)
$end_multi_text
+Wave Name: XM-Tylium-04.ogg

$Name: Halyard Flak
$Team: -1
$MessageNew:  XSTR("Halyard here, flak is up. Keep the bandits inside our umbrella and we'll help you thin them out.", -1)
$end_multi_text
+Wave Name: XM-Tylium-05.ogg

$Name: S Maulers
$Team: -1
$MessageNew:  XSTR("Heavy Raiders ahead of the convoy! They're lining up on the Cassia. If those torpedoes hit a tylium tanker, there won't be a tanker.", -1)
$end_multi_text
+Wave Name: XM-Tylium-06.ogg

$Name: Cassia Spool
$Team: -1
$MessageNew:  XSTR("Cassia spooling FTL. Twelve seconds. Hesper, Halyard, stay on my jump coordinates.", -1)
$end_multi_text
+Wave Name: XM-Tylium-07.ogg

$Name: HQ Win
$Team: -1
$MessageNew:  XSTR("Cassia and Hesper are clear and on their way to the fleet. That fuel buys us weeks. Good work, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Tylium-08.ogg

$Name: HQ Cassia Lost
$Team: -1
$MessageNew:  XSTR("The Cassia is gone. We just lost half the fleet's fuel. Get what's left home, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Tylium-09.ogg

$Name: HQ Hesper Lost
$Team: -1
$MessageNew:  XSTR("Hesper is down. Keep the Cassia alive, she's all we have left.", -1)
$end_multi_text
+Wave Name: XM-Tylium-10.ogg

$Name: Chatter 1
$Team: -1
$MessageNew:  XSTR("Shadow here. Keep it tight, Flask. Every drop on that tanker is a Viper sortie next month.", -1)
$end_multi_text
+Wave Name: XM-Tylium-11.ogg

$Name: Chatter 2
$Team: -1
$MessageNew:  XSTR("Copy. Funny, my last job before the war was hauling fuel. Never thought I'd miss it.", -1)
$end_multi_text
+Wave Name: XM-Tylium-12.ogg

$Name: Chatter 3
$Team: -1
$MessageNew:  XSTR("Cassia to escort, I can hear them on our hull frequency. Please tell me that's your guns.", -1)
$end_multi_text
+Wave Name: XM-Tylium-13.ogg

$Name: Chatter 4
$Team: -1
$MessageNew:  XSTR("These advanced models break hard to port every time. Lead them and they're yours.", -1)
$end_multi_text
+Wave Name: XM-Tylium-14.ogg

$Name: Chatter 5
$Team: -1
$MessageNew:  XSTR("Halyard to Red flight, our flak has the Heavies bracketed. Push them into it.", -1)
$end_multi_text
+Wave Name: XM-Tylium-15.ogg

$Name: Chatter 6
$Team: -1
$MessageNew:  XSTR("Lords, I'll be glad to see the back of that tanker. Nothing personal, Cassia.", -1)
$end_multi_text
+Wave Name: XM-Tylium-16.ogg

