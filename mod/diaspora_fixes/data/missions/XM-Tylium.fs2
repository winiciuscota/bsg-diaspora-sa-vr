#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("The tylium is aboard the fleet's tankers and the Viper squadrons will fly another month. The Cylons tried to starve us and you said no. Well flown, Thunderlords.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Heavy Raiders carry torpedoes. Kill them before they reach firing range of the convoy.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Cassia Lost" 0 )
$Multi text
    XSTR("The Cassia blew apart with three thousand tonnes of fuel aboard. The fleet will have to ration flight hours. We cannot afford another loss like that.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Stay close to the tanker. The Maulers arrive late and from ahead of the convoy.", -1)
$end_multi_text

#Callsigns:
$Callsign: Shadow
$Callsign: Flask

