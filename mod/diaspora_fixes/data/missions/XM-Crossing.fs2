#Events		;! 17 total

$Formula: ( when ( true ) ( do-nothing ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 3 ) ( send-message "#Command" "High" "L1 Crossing" ) )
+Name: Say L1 Crossing
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 20 ) ( not ( is-destroyed-delay 0 "Mover 1" ) ) ) ( send-message "Mover 1" "High" "L2 Crossing" ) )
+Name: Say L2 Crossing
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 95 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "L3 Crossing" ) )
+Name: Say L3 Crossing
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 215 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "High" "L4 Crossing" ) )
+Name: Say L4 Crossing
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 365 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "L5 Crossing" ) )
+Name: Say L5 Crossing
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 520 ) ( not ( is-destroyed-delay 0 "Mover 2" ) ) ) ( send-message "Mover 2" "High" "L6 Crossing" ) )
+Name: Say L6 Crossing
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 690 ) ( send-message "#Command" "High" "L7 Crossing" ) )
+Name: Say L7 Crossing
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 840 ) ( do-nothing ) )
+Name: Jump
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-departed-delay 3 "Mover 1" ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Cond" 0 ) ( send-message "#Command" "High" "W Crossing" ) )
+Name: Win Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Msg" 3 ) ( do-nothing ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Mover 1" ) ( send-message "#Command" "High" "F Crossing" ) )
+Name: Mover 1 Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Mover 1 Lost" 8 ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

