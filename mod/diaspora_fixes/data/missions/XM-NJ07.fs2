#Events		;! 20 total

$Formula: ( when ( true ) ( do-nothing ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 3 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "L1 NJ07" ) )
+Name: Say L1 NJ07
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 30 ) ( not ( is-destroyed-delay 0 "Nightjar 2" ) ) ) ( send-message "Nightjar 2" "High" "L2 NJ07" ) )
+Name: Say L2 NJ07
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 125 ) ( not ( is-destroyed-delay 0 "Nightjar 3" ) ) ) ( send-message "Nightjar 3" "High" "L3 NJ07" ) )
+Name: Say L3 NJ07
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 205 ) ( not ( is-destroyed-delay 0 "Nightjar 2" ) ) ) ( send-message "Nightjar 2" "High" "L4 NJ07" ) )
+Name: Say L4 NJ07
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 330 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "L5 NJ07" ) )
+Name: Say L5 NJ07
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( < ( distance "Answer 1" "Marker" ) 2600 ) ( do-nothing ) )
+Name: Spring
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Spring" 1 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "Spring NJ07" ) )
+Name: Say Spring NJ07
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( percent-ships-destroyed 100 "Answer" ) ( percent-ships-destroyed 100 "Escort" ) ) ( do-nothing ) )
+Name: Cleared
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Cleared" 2 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "Clear NJ07" ) )
+Name: Say Clear NJ07
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Cleared" 0 ) ( > ( distance "Nightjar 1" "Marker" ) 4500 ) ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Cond" 0 ) ( send-message "#Command" "High" "W NJ07" ) )
+Name: Win Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Msg" 3 ) ( do-nothing ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Nightjar 1" ) ( send-message "#Command" "High" "F NJ07" ) )
+Name: Lead Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Lifeline 1" ) ( send-message "#Command" "High" "F NJ07" ) )
+Name: Bait Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 900 ) ( send-message "#Command" "High" "F NJ07" ) )
+Name: Too Late
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Lead Lost" 8 ) ( is-event-true-delay "Bait Lost" 8 ) ( is-event-true-delay "Too Late" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

