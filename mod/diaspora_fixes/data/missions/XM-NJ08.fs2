$Formula: ( when ( and ( is-event-true-delay "Start" 390 ) ( not ( is-destroyed-delay 0 "Nightjar 3" ) ) ) ( send-message "Nightjar 3" "High" "L4 NJ08" ) )
+Name: Say L4 NJ08
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 520 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "L5 NJ08" ) )
+Name: Say L5 NJ08
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( < ( distance "Lifeline 1" "Pod 1" ) 220 ) ( do-nothing ) )
+Name: Pod 1 Near
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Pod 1 Near" 12 ) ( ship-vanish "Pod 1" ) )
+Name: Pod 1 Saved
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Pod 1 Saved" 2 ) ( add-goal "Lifeline 1" ( ai-waypoints-once "Leg 2" 60 ) ) )
+Name: Leg 2 Go
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Pod 1 Saved" 3 ) ( send-message "Lifeline 1" "High" "Saved 1" ) )
+Name: Saved Msg 1
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( < ( distance "Lifeline 1" "Pod 2" ) 220 ) ( do-nothing ) )
+Name: Pod 2 Near
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Pod 2 Near" 12 ) ( ship-vanish "Pod 2" ) )
+Name: Pod 2 Saved
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Pod 2 Saved" 2 ) ( add-goal "Lifeline 1" ( ai-waypoints-once "Home" 80 ) ) )
+Name: Leg 3 Go
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Pod 2 Saved" 3 ) ( send-message "Lifeline 1" "High" "Saved 2" ) )
+Name: Saved Msg 2
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Pod 2 Saved" 55 ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Cond" 0 ) ( send-message "#Command" "High" "W NJ08" ) )
+Name: Win Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Msg" 3 ) ( do-nothing ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Lifeline 1" ) ( send-message "#Command" "High" "F NJ08" ) )
+Name: Lifeline Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Pod 1" ) ( send-message "#Command" "High" "F NJ08" ) )
+Name: Pod 1 Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Pod 2" ) ( send-message "#Command" "High" "F NJ08" ) )
+Name: Pod 2 Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Lifeline Lost" 8 ) ( is-event-true-delay "Pod 1 Lost" 8 ) ( is-event-true-delay "Pod 2 Lost" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

