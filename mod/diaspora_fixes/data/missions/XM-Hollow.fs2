#Events		;! 30 total

$Formula: ( when ( true ) ( ship-guardian-threshold 25 "Kestrel" ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 3 ) ( send-message "#Command" "High" "HQ Orders" ) )
+Name: Orders Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Orders Msg" 14 ) ( send-message "Red 3" "High" "F Rocks" ) )
+Name: Rocks Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Rocks Msg" 10 ) ( send-message "Kestrel" "High" "Kestrel Hail" ) )
+Name: Kestrel Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Kestrel Msg" 8 ) ( do-nothing ) )
+Name: Ambush
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 2 "Shale" ) ( send-message "Red 2" "High" "S Ambush" ) )
+Name: Ambush Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Ambush" 65 ) ( do-nothing ) )
+Name: Boarders
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Brute" ) ( send-message "#Command" "High" "HQ Boarders" ) )
+Name: Boarders Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 10 "Brute" ) ( send-message "Red 3" "High" "F Brutes" ) )
+Name: Brutes Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Brute 1" "Brute 2" ) ( do-nothing ) )
+Name: Brutes Down
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 2 "Lantern 2" ) ( send-message "Lantern 2" "High" "Lantern Arrive" ) )
+Name: Lantern Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Brutes Down" 40 ) ( send-message "Kestrel" "High" "Kestrel Spool" ) )
+Name: Kestrel Jump
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-departed-delay 3 "Kestrel" ) ( send-message "#Command" "High" "HQ Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( < ( distance "Brute 1" "Kestrel" ) 180 ) ( < ( distance "Brute 2" "Kestrel" ) 180 ) ) ( send-message "#Command" "High" "HQ Boarded" ) )
+Name: Boarded
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Kestrel" ) ( send-message "#Command" "High" "HQ Kestrel Lost" ) )
+Name: Kestrel Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Boarded" 8 ) ( is-event-true-delay "Kestrel Lost" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Rocks Msg" 6 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 1" ) )
+Name: Chatter 1 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Kestrel Msg" 6 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 2" ) )
+Name: Chatter 2 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Ambush Msg" 18 ) ( not ( is-destroyed-delay 0 "Kestrel" ) ) ) ( send-message "Kestrel" "Normal" "Chatter 3" ) )
+Name: Chatter 3 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Boarders Msg" 8 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 4" ) )
+Name: Chatter 4 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Brutes Down" 3 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 5" ) )
+Name: Chatter 5 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Lantern Msg" 10 ) ( not ( is-destroyed-delay 0 "Kestrel" ) ) ) ( send-message "Kestrel" "Normal" "Chatter 6" ) )
+Name: Chatter 6 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 140 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "More 1" ) )
+Name: More 1 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 290 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "More 2" ) )
+Name: More 2 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 430 ) ( not ( is-destroyed-delay 0 "Kestrel" ) ) ) ( send-message "Kestrel" "Normal" "More 3" ) )
+Name: More 3 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 570 ) ( send-message "#Command" "Normal" "More 4" ) )
+Name: More 4 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 680 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "More 5" ) )
+Name: More 5 Msg
+Repeat Count: 1
+Interval: 1

#Goals		;! 3 total

$Type: Primary
+Name: Save the Kestrel
$MessageNew:  XSTR("Get the Kestrel and her crew out of Hollow Rock", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Primary
+Name: Stop the boarders
$MessageNew:  XSTR("Destroy the Heavy Raiders before they reach the Kestrel", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Brutes Down" 0 )
+Score: 100

$Type: Secondary
+Name: Clear the ambush
$MessageNew:  XSTR("Destroy the Raiders hiding in the rocks", -1)
$end_multi_text
$Formula: ( percent-ships-destroyed 75 "Shale" "Flint" )
+Score: 50

#Waypoints		;! 0 lists total

#Messages		;! 22 total

$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("Red flight, the Kestrel's beacon is coming from the middle of Hollow Rock. Go in slow. If she's adrift, Lantern 2 will come and take her crew off.", -1)
$end_multi_text
+Wave Name: XM-Hollow-01.ogg

$Name: F Rocks
$Team: -1
$MessageNew:  XSTR("Lot of rocks out here, Red Leader. A whole basestar could hide in this.", -1)
$end_multi_text
+Wave Name: XM-Hollow-02.ogg

$Name: Kestrel Hail
$Team: -1
$MessageNew:  XSTR("Viper flight, Viper flight, this is Kestrel! Engines dead, eleven aboard. There's something moving in the rocks, it's been circling us for hours.", -1)
$end_multi_text
+Wave Name: XM-Hollow-03.ogg

$Name: S Ambush
$Team: -1
$MessageNew:  XSTR("Raiders! They were sitting in the rocks! It's a trap, break, break!", -1)
$end_multi_text
+Wave Name: XM-Hollow-04.ogg

$Name: HQ Boarders
$Team: -1
$MessageNew:  XSTR("Red flight, DRADIS has Heavy Raiders inbound to the Kestrel. Those are boarding craft. Do not let them reach that mover.", -1)
$end_multi_text
+Wave Name: XM-Hollow-05.ogg

$Name: F Brutes
$Team: -1
$MessageNew:  XSTR("Two Heavies with escorts. Take the Heavies, the escorts can wait.", -1)
$end_multi_text
+Wave Name: XM-Hollow-06.ogg

$Name: Lantern Arrive
$Team: -1
$MessageNew:  XSTR("Lantern 2 inbound. Kestrel, get your people to the airlock, we're taking you home.", -1)
$end_multi_text
+Wave Name: XM-Hollow-07.ogg

$Name: Kestrel Spool
$Team: -1
$MessageNew:  XSTR("Our jump drive just came back! Lantern, we'll follow you out. Thank you, Thunderlords.", -1)
$end_multi_text
+Wave Name: XM-Hollow-08.ogg

$Name: HQ Win
$Team: -1
$MessageNew:  XSTR("Kestrel and Lantern 2 are clear of Hollow Rock. Eleven miners coming home. Bring it in, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Hollow-09.ogg

$Name: HQ Boarded
$Team: -1
$MessageNew:  XSTR("The Cylons have boarded the Kestrel. We've lost her. Break off and return to Theseus.", -1)
$end_multi_text
+Wave Name: XM-Hollow-10.ogg

$Name: HQ Kestrel Lost
$Team: -1
$MessageNew:  XSTR("Kestrel is gone. Gods. Return to Theseus, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Hollow-11.ogg

$Name: Chatter 1
$Team: -1
$MessageNew:  XSTR("DRADIS is useless in here, too much iron in the rocks. Eyes open.", -1)
$end_multi_text
+Wave Name: XM-Hollow-12.ogg

$Name: Chatter 2
$Team: -1
$MessageNew:  XSTR("Eleven people sitting dark for six hours. I don't know how they kept their heads.", -1)
$end_multi_text
+Wave Name: XM-Hollow-13.ogg

$Name: Chatter 3
$Team: -1
$MessageNew:  XSTR("We can see your guns from here! Gods bless you, keep shooting!", -1)
$end_multi_text
+Wave Name: XM-Hollow-14.ogg

$Name: Chatter 4
$Team: -1
$MessageNew:  XSTR("Heavies inbound. Forget the small ones, they want the mover's crew alive.", -1)
$end_multi_text
+Wave Name: XM-Hollow-15.ogg

$Name: Chatter 5
$Team: -1
$MessageNew:  XSTR("Splash two boarders! That's the last of them!", -1)
$end_multi_text
+Wave Name: XM-Hollow-16.ogg

$Name: Chatter 6
$Team: -1
$MessageNew:  XSTR("Lantern, we're at the airlock. Some of the kids are scared of the noise, go easy.", -1)
$end_multi_text
+Wave Name: XM-Hollow-17.ogg

$Name: More 1
$Team: -1
$MessageNew:  XSTR("Rocks everywhere. I keep ducking for no reason.", -1)
$end_multi_text
+Wave Name: XM-Hollow-18.ogg

$Name: More 2
$Team: -1
$MessageNew:  XSTR("Every rock is a contact in here. My DRADIS has given up on honesty.", -1)
$end_multi_text
+Wave Name: XM-Hollow-19.ogg

$Name: More 3
$Team: -1
$MessageNew:  XSTR("Kestrel to Red flight, we heard engines through the hull. Please tell me they're yours.", -1)
$end_multi_text
+Wave Name: XM-Hollow-20.ogg

$Name: More 4
$Team: -1
$MessageNew:  XSTR("Theseus to Red flight, mind your headings. There is a great deal of rock between you and home.", -1)
$end_multi_text
+Wave Name: XM-Hollow-21.ogg

$Name: More 5
$Team: -1
$MessageNew:  XSTR("If I get out of here with my paint intact, I'm buying everyone a round.", -1)
$end_multi_text
+Wave Name: XM-Hollow-22.ogg

