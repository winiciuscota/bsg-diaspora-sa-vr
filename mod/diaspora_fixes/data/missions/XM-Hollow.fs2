#Command Briefing

#Briefing
$start_briefing
$num_stages: 1
$start_stage
$multi_text
 XSTR("The mining mover Kestrel stopped answering six hours ago inside the Hollow Rock field. Her beacon is still pinging. Red flight goes in to find her and bring her crew home, and Theseus suspects the Cylons are using the rocks to hide. Objectives. Get the Kestrel and her crew out of Hollow Rock. Destroy the Heavy Raiders before they reach the Kestrel.", -1)
$end_multi_text
$voice: XM-Hollow-B-01.ogg
$camera_pos: 0.000000, 3000.000000, -9000.000000
$camera_orient:
	1.000000, 0.000000, 0.000000,
	0.000000, 0.939693, 0.342020,
	0.000000, -0.342020, 0.939693,
$camera_time: 500
$num_lines: 0
$num_icons: 0
$Flags: 1
$Formula: ( true ) 
$end_stage
$end_briefing

#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Eleven miners are eating real food aboard Theseus tonight. The Cylons were using Hollow Rock as a hunting blind, and you turned it into a graveyard. Good work.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Heavy Raiders inside the rocks are boarding craft. They don't need to win the fight, only to reach their target.", -1)
$end_multi_text

$Formula: ( or ( is-event-true-delay "Boarded" 0 ) ( is-event-true-delay "Kestrel Lost" 0 ) )
$Multi text
    XSTR("We lost the Kestrel. Whatever the Cylons wanted with eleven miners, they have it now.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Ignore the escorts when the Heavy Raiders show up and go straight for the boarding craft.", -1)
$end_multi_text

#Callsigns:
$Callsign: Shadow
$Callsign: Flask

#end


