$Formula: ( when ( true ) ( do-nothing ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 3 ) ( send-message "#Command" "High" "L1 Gauntlet" ) )
+Name: Say L1 Gauntlet
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 30 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "High" "L2 Gauntlet" ) )
+Name: Say L2 Gauntlet
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 150 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "L3 Gauntlet" ) )
+Name: Say L3 Gauntlet
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 270 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "L4 Gauntlet" ) )
+Name: Say L4 Gauntlet
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 500 ) ( not ( is-destroyed-delay 0 "Cassia" ) ) ) ( send-message "Cassia" "High" "L5 Gauntlet" ) )
+Name: Say L5 Gauntlet
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 640 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "High" "L6 Gauntlet" ) )
+Name: Say L6 Gauntlet
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 1000 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "L7 Gauntlet" ) )
+Name: Say L7 Gauntlet
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 1250 ) ( send-message "#Command" "High" "L8 Gauntlet" ) )
+Name: Say L8 Gauntlet
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 1340 ) ( not ( is-destroyed-delay 0 "Cassia" ) ) ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Cond" 0 ) ( send-message "#Command" "High" "W Gauntlet" ) )
+Name: Win Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Msg" 3 ) ( do-nothing ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Cassia" ) ( send-message "#Command" "High" "F Gauntlet" ) )
+Name: Cassia Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Hesper" ) ( send-message "#Command" "High" "F Gauntlet" ) )
+Name: Hesper Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Cassia Lost" 8 ) ( is-event-true-delay "Hesper Lost" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

