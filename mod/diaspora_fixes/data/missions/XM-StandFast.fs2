+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 205 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "S Needles" ) )
+Name: Say S Needles
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 240 ) ( send-message "#Command" "High" "S Blue" ) )
+Name: Say S Blue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 315 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "High" "S Fang" ) )
+Name: Say S Fang
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 400 ) ( send-message "#Command" "High" "S Basestar" ) )
