#Command Briefing

#Briefing
$start_briefing
$num_stages: 1
$start_stage
$multi_text
 XSTR("The freighter Hesper and the passenger liner Pilgrim Mercy made a bad jump and are dead in space with their drives cooked, eleven minutes from the Theseus. The Bolitho frigate Halyard and three Assault Raptors jumped in to help, but the Cylons found them first and they keep coming. Keep the Hesper and the Pilgrim Mercy alive until the battlestar jumps in. Objectives. Keep the freighter alive until the Theseus arrives. Keep the passenger liner alive until the Theseus arrives.", -1)
$end_multi_text
$voice: XM-StandFast-B-01.ogg
$camera_pos: 0.000000, 3000.000000, -9000.000000
$camera_orient:
	1.000000, 0.000000, 0.000000,
	0.000000, 0.939693, 0.342020,
	0.000000, -0.342020, 0.939693,
$camera_time: 500
$num_lines: 0
$num_icons: 0
$Flags: 1
$Formula: ( true ) 
$end_stage
$end_briefing

#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Eleven minutes, eleven waves and a basestar, and both civilian ships are still in one piece. The Halyard took the worst of it.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Kill the Heavy Raiders first, they are the only wave that can hurt the Halyard.", -1)
$end_multi_text

$Formula: ( or ( is-event-true-delay "Hesper Lost" 0 ) ( is-event-true-delay "Mercy Lost" 0 ) )
$Multi text
    XSTR("A civilian ship was lost before the Theseus came.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("The Raiders go for the civilians first: put Red flight between each wave and its target.", -1)
$end_multi_text

