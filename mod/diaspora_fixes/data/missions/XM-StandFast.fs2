+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Pilgrim Mercy" ) ( send-message "#Command" "High" "S Lost2" ) )
+Name: Mercy Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Hesper Lost" 8 ) ( is-event-true-delay "Mercy Lost" 8 ) ) ( fade-out 1000 ) )
