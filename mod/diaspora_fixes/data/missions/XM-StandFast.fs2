#Goals		;! 4 total

$Type: Primary
+Name: Protect the Hesper
$MessageNew:  XSTR("Keep the freighter alive until the Theseus arrives", -1)
$end_multi_text
$Formula: ( and ( is-event-true-delay "Win" 0 ) ( not ( is-destroyed-delay 0 "Hesper" ) ) )
+Score: 100

$Type: Primary
+Name: Protect the Pilgrim Mercy
$MessageNew:  XSTR("Keep the passenger liner alive until the Theseus arrives", -1)
$end_multi_text
$Formula: ( and ( is-event-true-delay "Win" 0 ) ( not ( is-destroyed-delay 0 "Pilgrim Mercy" ) ) )
+Score: 100

$Type: Bonus
+Name: Keep the Halyard
$MessageNew:  XSTR("The Bolitho frigate must survive", -1)
$end_multi_text
$Formula: ( and ( is-event-true-delay "Win" 0 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) )
+Score: 50

$Type: Bonus
+Name: Sink the Anvil
$MessageNew:  XSTR("Destroy the hunting basestar", -1)
$end_multi_text
$Formula: ( is-destroyed-delay 0 "Anvil" )
+Score: 50

