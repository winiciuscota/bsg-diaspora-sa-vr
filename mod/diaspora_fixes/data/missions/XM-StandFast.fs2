$Formula: ( when ( and ( is-event-true-delay "Start" 660 ) ( not ( is-destroyed-delay 0 "Theseus" ) ) ) ( send-message "Theseus" "High" "S Theseus" ) )
+Name: Say S Theseus
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 700 ) ( percent-ships-destroyed 60 "Wave" ) ( percent-ships-destroyed 60 "Last" ) ( percent-ships-destroyed 60 "Hunter" ) ) ( do-nothing ) )
+Name: Cleared
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Cleared" 25 ) ( send-message "#Command" "High" "S Win" ) )
+Name: Win
