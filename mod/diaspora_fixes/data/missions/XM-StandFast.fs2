#Messages		;! 21 total

$Command Sender: Theseus

$Name: S Orders
$Team: -1
$MessageNew:  XSTR("Red flight, the Hesper and the Pilgrim Mercy made a bad jump and are dead in space. Halyard jumped in to cover them with three assault Raptors and Green flight. The Theseus is eleven minutes out. Hold the line and keep the civilians alive.", -1)
$end_multi_text
+Wave Name: XM-StandFast-01.ogg

$Name: S Halyard
$Team: -1
$MessageNew:  XSTR("Halyard to Red flight, we jumped in as soon as we got their call. We can't tow them, we can only guard them. Stay close.", -1)
$end_multi_text
+Wave Name: XM-StandFast-02.ogg

$Name: S Scouts
$Team: -1
$MessageNew:  XSTR("Contacts, six Raiders, bearing zero three zero. They're going for the Hesper!", -1)
$end_multi_text
+Wave Name: XM-StandFast-03.ogg

$Name: S Menders
$Team: -1
$MessageNew:  XSTR("Mender one, three assault Raptors on station. We're sitting right on the civilians, nobody gets a clear shot at them without going through us.", -1)
$end_multi_text
+Wave Name: XM-StandFast-04.ogg

$Name: S Mercy
$Team: -1
$MessageNew:  XSTR("Pilgrim Mercy! There are eight more coming at us from the port side! We have three hundred people aboard!", -1)
$end_multi_text
+Wave Name: XM-StandFast-05.ogg

$Name: S Eight
$Team: -1
$MessageNew:  XSTR("Theseus to Red flight, eight minutes. Hang on.", -1)
$end_multi_text
+Wave Name: XM-StandFast-06.ogg

$Name: S Heavies
$Team: -1
$MessageNew:  XSTR("Heavy Raiders high above us! Concentrate fire, don't let them reach the passenger liner.", -1)
$end_multi_text
+Wave Name: XM-StandFast-07.ogg

$Name: S Needles
$Team: -1
$MessageNew:  XSTR("Advanced Raiders from the rear! They're fast, stay on them!", -1)
$end_multi_text
+Wave Name: XM-StandFast-08.ogg

$Name: S Blue
$Team: -1
$MessageNew:  XSTR("Blue flight is jumping in to reinforce you. Five minutes, Red flight.", -1)
$end_multi_text
+Wave Name: XM-StandFast-09.ogg

$Name: S Fang
$Team: -1
$MessageNew:  XSTR("Another wave from below, there's no end to them!", -1)
$end_multi_text
+Wave Name: XM-StandFast-10.ogg

$Name: S Basestar
$Team: -1
$MessageNew:  XSTR("DRADIS, basestar, bearing one four zero! It's hunting the Halyard. Four minutes, Red flight.", -1)
$end_multi_text
+Wave Name: XM-StandFast-11.ogg

$Name: S Last
$Team: -1
$MessageNew:  XSTR("Last wave coming in. One hundred seconds to the Theseus!", -1)
$end_multi_text
+Wave Name: XM-StandFast-12.ogg

$Name: S Theseus
$Team: -1
$MessageNew:  XSTR("Theseus is here! All guns, open fire. Red flight, well held.", -1)
$end_multi_text
+Wave Name: XM-StandFast-13.ogg

$Name: S Win
$Team: -1
$MessageNew:  XSTR("The Cylons are breaking off and the Hesper and the Pilgrim Mercy are alive. The fleet owes you a drink, Red flight.", -1)
$end_multi_text
+Wave Name: XM-StandFast-14.ogg

$Name: S Lost1
$Team: -1
$MessageNew:  XSTR("We lost the Hesper. Break off, Red flight.", -1)
$end_multi_text
+Wave Name: XM-StandFast-15.ogg

$Name: S Lost2
$Team: -1
$MessageNew:  XSTR("We lost the Pilgrim Mercy. Break off, Red flight.", -1)
$end_multi_text
+Wave Name: XM-StandFast-16.ogg

$Name: More 1
$Team: -1
$MessageNew:  XSTR("Eleven minutes. I've had longer arguments with my sister.", -1)
$end_multi_text
+Wave Name: XM-StandFast-17.ogg

$Name: More 2
$Team: -1
$MessageNew:  XSTR("Green flight is spread thin. Let's give them cover.", -1)
$end_multi_text
+Wave Name: XM-StandFast-18.ogg

$Name: More 3
$Team: -1
$MessageNew:  XSTR("Halyard to all, the Raptors are holding the civilians in a tight knot. Stay close to them.", -1)
$end_multi_text
+Wave Name: XM-StandFast-19.ogg

$Name: More 4
$Team: -1
$MessageNew:  XSTR("Mender one, I'm counting the seconds. You count the Raiders.", -1)
$end_multi_text
+Wave Name: XM-StandFast-20.ogg

$Name: More 5
$Team: -1
$MessageNew:  XSTR("Theseus to Red flight, ninety seconds. Hold them.", -1)
$end_multi_text
+Wave Name: XM-StandFast-21.ogg

