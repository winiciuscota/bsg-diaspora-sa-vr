#Events		;! 27 total

$Formula: ( when ( true ) ( do-nothing ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 2 ) ( send-message "#Command" "High" "S Orders" ) )
+Name: Say S Orders
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 14 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "High" "S Halyard" ) )
+Name: Say S Halyard
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 40 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "High" "S Scouts" ) )
