+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 330 ) ( send-message "#Command" "High" "L5 Quiet" ) )
+Name: Say L5 Quiet
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 380 ) ( not ( is-destroyed-delay 0 "Pixie" ) ) ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

