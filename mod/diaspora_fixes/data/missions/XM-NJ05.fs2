#Events		;! 19 total

$Formula: ( when ( true ) ( do-nothing ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 3 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "L1 NJ05" ) )
+Name: Say L1 NJ05
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 22 ) ( not ( is-destroyed-delay 0 "Nightjar 2" ) ) ) ( send-message "Nightjar 2" "High" "L2 NJ05" ) )
+Name: Say L2 NJ05
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 200 ) ( not ( is-destroyed-delay 0 "Nightjar 3" ) ) ) ( send-message "Nightjar 3" "High" "L3 NJ05" ) )
+Name: Say L3 NJ05
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 420 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "L4 NJ05" ) )
+Name: Say L4 NJ05
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 500 ) ( not ( is-destroyed-delay 0 "Nightjar 2" ) ) ) ( send-message "Nightjar 2" "High" "L5 NJ05" ) )
+Name: Say L5 NJ05
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 0 "Depot" ) ( do-nothing ) )
+Name: Alarm
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Alarm" 1 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "Alarm NJ05" ) )
+Name: Say Alarm NJ05
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 0 "Depot" "Hauler A" "Hauler B" ) ( do-nothing ) )
+Name: Cleared
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Cleared" 2 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "Clear NJ05" ) )
+Name: Say Clear NJ05
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Cleared" 0 ) ( > ( distance "Nightjar 1" "Marker" ) 6000 ) ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Cond" 0 ) ( send-message "#Command" "High" "W NJ05" ) )
+Name: Win Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Msg" 3 ) ( do-nothing ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Nightjar 1" ) ( send-message "#Command" "High" "F NJ05" ) )
+Name: Lead Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 900 ) ( send-message "#Command" "High" "F NJ05" ) )
+Name: Too Late
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Lead Lost" 8 ) ( is-event-true-delay "Too Late" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

