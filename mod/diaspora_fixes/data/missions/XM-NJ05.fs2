#Messages		;! 9 total

$Command Sender: Theseus

$Name: L1 NJ05
$Team: -1
$MessageNew:  XSTR("Nightjars, that depot fuels twelve wings. We burn it today. They'll send a basestar when it starts to burn, so we can't be slow.", -1)
$end_multi_text
+Wave Name: XM-NJ05-01.ogg

$Name: L2 NJ05
$Team: -1
$MessageNew:  XSTR("Four Raiders, two Heavies guarding. Standard.", -1)
$end_multi_text
+Wave Name: XM-NJ05-02.ogg

$Name: L3 NJ05
$Team: -1
$MessageNew:  XSTR("Depot's venting. Looks like a pyre.", -1)
$end_multi_text
+Wave Name: XM-NJ05-03.ogg

$Name: L4 NJ05
$Team: -1
$MessageNew:  XSTR("Basestar's here! Break contact, break contact!", -1)
$end_multi_text
+Wave Name: XM-NJ05-04.ogg

$Name: L5 NJ05
$Team: -1
$MessageNew:  XSTR("She's launching. Run, run!", -1)
$end_multi_text
+Wave Name: XM-NJ05-05.ogg

$Name: Alarm NJ05
$Team: -1
$MessageNew:  XSTR("First kill confirmed. The basestar is jumping in. Two minutes. Finish the targets and run.", -1)
$end_multi_text
+Wave Name: XM-NJ05-06.ogg

