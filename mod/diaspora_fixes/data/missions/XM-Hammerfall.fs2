#Events		;! 22 total

$Formula: ( when ( true ) ( ship-guardian-threshold 20 "Halyard" ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 2 ) ( send-message "#Command" "High" "H Orders" ) )
+Name: Say H Orders
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 20 ) ( not ( is-destroyed-delay 0 "Blue 1" ) ) ) ( send-message "Blue 1" "High" "H Ghost" ) )
+Name: Say H Ghost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 32 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "High" "H Halyard" ) )
+Name: Say H Halyard
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 150 ) ( percent-ships-destroyed 70 "Screen" ) ) ( do-nothing ) )
+Name: Phase 2
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Phase 2" 6 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "H Lance" ) )
+Name: Say H Lance
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Phase 2" 240 ) ( percent-ships-destroyed 70 "Lance" ) ) ( do-nothing ) )
+Name: Phase 3
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Phase 3" 6 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "H Veil" ) )
+Name: Say H Veil
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Phase 3" 120 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "High" "H Alpha Hit" ) )
+Name: Say H Alpha Hit
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Phase 3" 200 ) ( is-destroyed-delay 0 "Alpha" ) ) ( do-nothing ) )
+Name: Beta In
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Beta In" 3 ) ( send-message "#Command" "High" "H Beta" ) )
+Name: Say H Beta
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Beta In" 40 ) ( do-nothing ) )
+Name: Theseus In
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Theseus In" 4 ) ( not ( is-destroyed-delay 0 "Theseus" ) ) ) ( send-message "Theseus" "High" "H Theseus" ) )
+Name: Say H Theseus
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Theseus In" 120 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "H Pyre" ) )
+Name: Say H Pyre
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Theseus In" 240 ) ( not ( is-destroyed-delay 0 "Theseus" ) ) ) ( send-message "Theseus" "High" "H Beta Hit" ) )
+Name: Say H Beta Hit
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-destroyed-delay 0 "Alpha" ) ( is-destroyed-delay 0 "Beta" ) ) ( send-message "#Command" "High" "H Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Halyard" ) ( send-message "#Command" "High" "H Lost" ) )
+Name: Halyard Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Theseus" ) ( send-message "#Command" "High" "H Lost" ) )
+Name: Theseus Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Halyard Lost" 8 ) ( is-event-true-delay "Theseus Lost" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

#Goals		;! 3 total

$Type: Primary
+Name: Destroy the Alpha
$MessageNew:  XSTR("Sink the damaged basestar", -1)
$end_multi_text
$Formula: ( is-destroyed-delay 0 "Alpha" )
+Score: 100

$Type: Primary
+Name: Destroy the Beta
$MessageNew:  XSTR("Sink the second basestar with the Theseus", -1)
$end_multi_text
$Formula: ( is-destroyed-delay 0 "Beta" )
+Score: 100

$Type: Bonus
+Name: Keep the fleet whole
$MessageNew:  XSTR("Do not lose either of Blue flight", -1)
$end_multi_text
$Formula: ( and ( not ( is-destroyed-delay 0 "Blue 1" ) ) ( not ( is-destroyed-delay 0 "Blue 2" ) ) )
+Score: 40

#Waypoints		;! 0 lists total

#Messages		;! 12 total

$Command Sender: Theseus

$Name: H Orders
$Team: -1
$MessageNew:  XSTR("Red flight, this is the strike on Ostrava Reach. The first basestar is already damaged. Halyard and Blue flight go in with you, Theseus follows in force once the second one shows. Destroy both.", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-01.ogg

$Name: H Ghost
$Team: -1
$MessageNew:  XSTR("Ghost and Rook on your wing, Red leader. Ready to light them up.", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-02.ogg

$Name: H Halyard
$Team: -1
$MessageNew:  XSTR("Halyard, flak is hot. We'll take the first bite of that basestar, you take the screen.", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-03.ogg

$Name: H Lance
$Team: -1
$MessageNew:  XSTR("Heavy Raiders from the basestar, torpedo profile! They want the Halyard!", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-04.ogg

$Name: H Veil
$Team: -1
$MessageNew:  XSTR("Advanced Raiders, five of them, hitting from high. They're good ones.", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-05.ogg

$Name: H Alpha Hit
$Team: -1
$MessageNew:  XSTR("We're hammering the basestar, her hull is breaking up! Keep the Raiders off us, Red flight!", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-06.ogg

$Name: H Beta
$Team: -1
$MessageNew:  XSTR("Second basestar jumping in, bearing three three zero! Theseus, you are clear to engage.", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-07.ogg

$Name: H Theseus
$Team: -1
$MessageNew:  XSTR("Theseus on station, all batteries. Red flight, you have the Raiders. We have the basestar.", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-08.ogg

$Name: H Pyre
$Team: -1
$MessageNew:  XSTR("Raiders everywhere, Theseus is drawing them but they keep coming! Cover the old girl!", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-09.ogg

$Name: H Beta Hit
$Team: -1
$MessageNew:  XSTR("Beta's hull is failing. Keep those Heavies off our bow, Red flight, one more minute!", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-10.ogg

$Name: H Win
$Team: -1
$MessageNew:  XSTR("Both basestars are gone and the Cylon staging area is wreckage. Fleet to Red flight: that's the best afternoon we've had in a year.", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-11.ogg

$Name: H Lost
$Team: -1
$MessageNew:  XSTR("The Halyard is gone and the strike has failed. Fall back to the fleet.", -1)
$end_multi_text
+Wave Name: XM-Hammerfall-12.ogg

