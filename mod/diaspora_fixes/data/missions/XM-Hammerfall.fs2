$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Both basestars are wreckage and the Cylon staging area is gone. A real victory for the fleet.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Clear the Raider screen before you press the basestar, the Heavies are what kill frigates.", -1)
$end_multi_text

$Formula: ( or ( is-event-true-delay "Halyard Lost" 0 ) ( is-event-true-delay "Theseus Lost" 0 ) )
$Multi text
    XSTR("We lost a capital ship and the strike with her.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Keep the Heavy Raiders off the Halyard and bring the Theseus in at the right moment.", -1)
$end_multi_text

