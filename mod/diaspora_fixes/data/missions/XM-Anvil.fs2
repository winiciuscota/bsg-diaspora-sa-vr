#Debriefing_info

$Num stages: 3

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("The strike never reached the fleet. Six nukes that would have killed thousands are drifting wreckage in the Ilion system, and the Halyard proved what a frigate can do with good pilots around her.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("The pickets are a distraction. Go for the Heavy Raiders first and let the Halyard's guns handle the escorts.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Partial" 0 )
$Multi text
    XSTR("Some of the Heavy Raiders jumped clear. The fleet is moving on emergency coordinates and we are counting on the Battlestar's guns to stop the rest.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("You have about three minutes. Missiles first on the Heavies, guns for whatever is left.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Halyard Lost" 0 )
$Multi text
    XSTR("We lost the Halyard. Without the anvil the hammer had nothing to strike against.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Keep the Advanced Raiders off the frigate when they arrive.", -1)
$end_multi_text

#Callsigns:
$Callsign: Shadow
