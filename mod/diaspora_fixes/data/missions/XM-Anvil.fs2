+Name: Halyard Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Halyard Msg" 6 ) ( send-message "Red 2" "High" "S Picket" ) )
+Name: Picket Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Picket Msg" 20 ) ( send-message "Red 3" "High" "F Moving" ) )
+Name: Moving Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Picket Msg" 55 ) ( do-nothing ) )
+Name: Escort Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Escort" ) ( send-message "Red 2" "High" "S Escort" ) )
+Name: Escort Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Picket Msg" 120 ) ( send-message "#Command" "High" "HQ One Minute" ) )
+Name: One Minute
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "One Minute" 60 ) ( send-message "#Command" "High" "HQ Jump" ) )
+Name: Strike Jump
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Strike 1" "Strike 2" "Strike 3" "Strike 4" "Strike 5" "Strike 6" ) ( do-nothing ) )
+Name: All Dead
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "All Dead" 0 ) ( is-event-true-delay "Strike Jump" 3 ) ) ( do-nothing ) )
+Name: Strike Over
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Strike Over" 3 ) ( percent-ships-destroyed 66 "Strike" ) ) ( send-message "#Command" "High" "HQ Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Strike Over" 3 ) ( not ( percent-ships-destroyed 66 "Strike" ) ) ) ( send-message "#Command" "High" "HQ Partial" ) )
+Name: Partial
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Win" 9 ) ( is-event-true-delay "Partial" 9 ) ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Halyard" ) ( send-message "#Command" "High" "HQ Halyard Lost" ) )
+Name: Halyard Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Halyard Lost" 8 ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Halyard Msg" 8 ) ( not ( is-destroyed-delay 0 "Blue 1" ) ) ) ( send-message "Blue 1" "Normal" "Chatter 1" ) )
+Name: Chatter 1 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Picket Msg" 14 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 2" ) )
+Name: Chatter 2 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Moving Msg" 10 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "Normal" "Chatter 3" ) )
+Name: Chatter 3 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Escort Msg" 10 ) ( not ( is-destroyed-delay 0 "Blue 2" ) ) ) ( send-message "Blue 2" "Normal" "Chatter 4" ) )
+Name: Chatter 4 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "One Minute" 6 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 5" ) )
+Name: Chatter 5 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "One Minute" 30 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "Normal" "Chatter 6" ) )
+Name: Chatter 6 Msg
+Repeat Count: 1
+Interval: 1

