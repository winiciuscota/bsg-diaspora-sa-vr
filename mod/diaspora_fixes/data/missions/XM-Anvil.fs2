$Formula: ( is-event-true-delay "Win" 0 )
+Score: 150

$Type: Secondary
+Name: Protect the Halyard
$MessageNew:  XSTR("Keep the frigate Halyard alive", -1)
$end_multi_text
$Formula: ( and ( is-event-true-delay "Strike Over" 0 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) )
+Score: 50

