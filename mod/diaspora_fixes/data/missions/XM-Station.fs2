$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Armistice Station is a dead hulk now, but everyone who worked on it is alive. The Halyard's crew have taken to calling Red flight their lucky charm.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Each wave goes for a different mover. Watch which one they are heading for and get there first.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "All Movers Lost" 0 )
$Multi text
    XSTR("None of the movers got away. The station's last crew died with it.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Let the Halyard handle the Advanced Raiders that go for her and stay with the movers.", -1)
$end_multi_text

