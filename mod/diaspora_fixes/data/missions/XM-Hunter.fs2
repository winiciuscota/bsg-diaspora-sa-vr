$Type: Primary
+Name: Spring the trap
$MessageNew:  XSTR("Protect the Halyard until she jumps", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Primary
+Name: Gut the raiding group
$MessageNew:  XSTR("Destroy most of the Raiders and Heavy Raiders", -1)
$end_multi_text
$Formula: ( percent-ships-destroyed 70 "Stalker" "Reaver" "Shade" )
+Score: 100

$Type: Bonus
+Name: No torpedo hits
$MessageNew:  XSTR("Destroy all three Heavy Raiders", -1)
$end_multi_text
