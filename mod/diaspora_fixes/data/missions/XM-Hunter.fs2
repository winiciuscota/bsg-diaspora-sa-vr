#Messages		;! 16 total

$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("Red flight, stay in the rocks and keep quiet. Halyard is sitting out there with her lights on. When the raiders go for her, hit them from behind.", -1)
$end_multi_text
+Wave Name: XM-Hunter-01.ogg

$Name: Halyard Hail
$Team: -1
$MessageNew:  XSTR("Halyard, ready. This is the strangest order I've ever followed. Don't be late, Red Leader.", -1)
$end_multi_text
+Wave Name: XM-Hunter-02.ogg

$Name: F Contact
$Team: -1
$MessageNew:  XSTR("Contacts! Raiders going for the Halyard. They took the bait!", -1)
$end_multi_text
+Wave Name: XM-Hunter-03.ogg

$Name: Halyard Flak
$Team: -1
$MessageNew:  XSTR("Taking fire! All batteries, flak! Red flight, they're yours!", -1)
$end_multi_text
+Wave Name: XM-Hunter-04.ogg

$Name: S Reavers
$Team: -1
$MessageNew:  XSTR("Heavy Raiders from below, torpedo profile! They're going for the frigate!", -1)
$end_multi_text
+Wave Name: XM-Hunter-05.ogg

$Name: F Shades
$Team: -1
$MessageNew:  XSTR("Advanced Raiders coming after us! Guess they found the trap.", -1)
$end_multi_text
+Wave Name: XM-Hunter-06.ogg

$Name: HQ Basestar
$Team: -1
$MessageNew:  XSTR("DRADIS, basestar! The raiding group has a mothership after all. Halyard, spool your FTL.", -1)
$end_multi_text
+Wave Name: XM-Hunter-07.ogg

$Name: Halyard Spool
$Team: -1
$MessageNew:  XSTR("Spooling. Sixty seconds. Keep them off our engines.", -1)
$end_multi_text
+Wave Name: XM-Hunter-08.ogg

$Name: HQ Win
$Team: -1
$MessageNew:  XSTR("Halyard has jumped. The raiding group is gutted and we know where its basestar hides. Well done, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Hunter-09.ogg

$Name: HQ Halyard Lost
$Team: -1
$MessageNew:  XSTR("The Halyard is gone. The bait got eaten. Break off, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Hunter-10.ogg

$Name: Chatter 1
$Team: -1
$MessageNew:  XSTR("Sitting in a rock waiting for Raiders. Feels like hunting with my uncle on Picon.", -1)
$end_multi_text
+Wave Name: XM-Hunter-11.ogg

$Name: Chatter 2
$Team: -1
$MessageNew:  XSTR("Your uncle hunted Cylons?", -1)
$end_multi_text
+Wave Name: XM-Hunter-12.ogg

$Name: Chatter 3
$Team: -1
$MessageNew:  XSTR("He hunted ridge deer. Same principle. Patience, then everything at once.", -1)
$end_multi_text
+Wave Name: XM-Hunter-13.ogg

$Name: Chatter 4
$Team: -1
$MessageNew:  XSTR("Wait for it. Let them commit to the frigate. Now! Go, go!", -1)
$end_multi_text
+Wave Name: XM-Hunter-14.ogg

$Name: Chatter 5
$Team: -1
$MessageNew:  XSTR("Torpedo in the water, port side! Brace, brace!", -1)
$end_multi_text
+Wave Name: XM-Hunter-15.ogg

$Name: Chatter 6
$Team: -1
$MessageNew:  XSTR("They're throwing everything at her now. Stay on the Halyard!", -1)
$end_multi_text
+Wave Name: XM-Hunter-16.ogg

