$Formula: ( when ( true ) ( ship-guardian-threshold 20 "Halyard" ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 2 ) ( send-message "#Command" "High" "HQ Orders" ) )
+Name: Orders Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Orders Msg" 14 ) ( send-message "Halyard" "High" "Halyard Hail" ) )
+Name: Halyard Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Halyard Msg" 20 ) ( do-nothing ) )
+Name: Bait Taken
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Stalker" ) ( send-message "Red 3" "High" "F Contact" ) )
+Name: Contact Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 14 "Stalker" ) ( send-message "Halyard" "High" "Halyard Flak" ) )
+Name: Flak Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Bait Taken" 60 ) ( do-nothing ) )
+Name: Reaver Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Reaver" ) ( send-message "Red 2" "High" "S Reavers" ) )
+Name: Reaver Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Shade" ) ( send-message "Red 3" "High" "F Shades" ) )
+Name: Shade Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Reaver Cue" 20 ) ( ship-no-guardian "Halyard" ) )
+Name: Guard Off
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Reaver Cue" 70 ) ( do-nothing ) )
+Name: Basestar Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Nemesis" ) ( send-message "#Command" "High" "HQ Basestar" ) )
+Name: Basestar Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Basestar Msg" 6 ) ( send-message "Halyard" "High" "Halyard Spool" ) )
+Name: Spool Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Spool Msg" 50 ) ( do-nothing ) )
+Name: Halyard Jump
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-departed-delay 2 "Halyard" ) ( send-message "#Command" "High" "HQ Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Halyard" ) ( send-message "#Command" "High" "HQ Halyard Lost" ) )
+Name: Halyard Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Halyard Lost" 8 ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Halyard Msg" 8 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 1" ) )
+Name: Chatter 1 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Halyard Msg" 16 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 2" ) )
+Name: Chatter 2 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Halyard Msg" 22 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 3" ) )
+Name: Chatter 3 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Contact Msg" 8 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 4" ) )
+Name: Chatter 4 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Reaver Msg" 12 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "Normal" "Chatter 5" ) )
+Name: Chatter 5 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Spool Msg" 14 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 6" ) )
