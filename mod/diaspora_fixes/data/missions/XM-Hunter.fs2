#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("The raiders that have been killing stragglers for weeks are wreckage in the Erebus cluster, and we know where their basestar comes from. The Halyard will want a less exciting job next time.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Hit the Raiders while they are busy with the frigate. They don't watch their backs.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Halyard Lost" 0 )
$Multi text
    XSTR("We lost the Halyard and her crew. The trap was sound, the timing was not.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Come out of the rocks as soon as the Raiders commit to the frigate, and save missiles for the Heavy Raiders.", -1)
$end_multi_text

#Callsigns:
$Callsign: Shadow
$Callsign: Flask

#end


