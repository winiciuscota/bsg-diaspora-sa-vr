#Events		;! 17 total

$Formula: ( when ( true ) ( ship-guardian-threshold 20 "Halyard" ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 2 ) ( send-message "#Command" "High" "HQ Orders" ) )
+Name: Orders Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Orders Msg" 10 ) ( send-message "Halyard" "High" "Halyard Hail" ) )
+Name: Halyard Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Halyard Msg" 25 ) ( do-nothing ) )
+Name: Scout Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Scout" ) ( send-message "Red 3" "High" "Scout Contact" ) )
+Name: Contact Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 12 "Scout" ) ( send-message "Halyard" "High" "Halyard Guns" ) )
+Name: Guns Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( percent-ships-destroyed 75 "Scout" ) ( do-nothing ) )
+Name: Scouts Down
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Spear" ) ( send-message "Red 2" "High" "Spear Contact" ) )
+Name: Spear Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Spear Msg" 0 ) ( percent-ships-destroyed 100 "Spear" ) ) ( send-message "#Command" "High" "HQ Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Halyard" ) ( send-message "#Command" "High" "HQ Halyard Lost" ) )
+Name: Halyard Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Halyard Lost" 8 ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 90 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "More 1" ) )
+Name: More 1 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 210 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "More 2" ) )
+Name: More 2 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 330 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "Normal" "More 3" ) )
+Name: More 3 Msg
+Repeat Count: 1
+Interval: 1

#Goals		;! 2 total

$Type: Primary
+Name: Hold the picket
$MessageNew:  XSTR("Keep the Halyard alive and destroy the Raiders", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Bonus
+Name: Stop the torpedoes
$MessageNew:  XSTR("Destroy both Heavy Raiders", -1)
$end_multi_text
$Formula: ( is-destroyed-delay 0 "Spear 1" "Spear 2" )
+Score: 30

#Waypoints		;! 0 lists total

#Messages		;! 10 total

$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("Red flight, Halyard is on picket at the edge of the fleet. Raiders have been testing the line all night. Stay close to her and answer anything that comes in.", -1)
$end_multi_text
+Wave Name: XM-Picket-01.ogg

$Name: Halyard Hail
$Team: -1
$MessageNew:  XSTR("Halyard, on station. Quiet so far. Which usually means it's about to be loud.", -1)
$end_multi_text
+Wave Name: XM-Picket-02.ogg

$Name: Scout Contact
$Team: -1
$MessageNew:  XSTR("Four Raiders, bearing zero three zero, coming in fast. They're after the Halyard.", -1)
$end_multi_text
+Wave Name: XM-Picket-03.ogg

$Name: Halyard Guns
$Team: -1
$MessageNew:  XSTR("Port battery, firing. Red flight, they're slipping past our flak. Take them.", -1)
$end_multi_text
+Wave Name: XM-Picket-04.ogg

$Name: Spear Contact
$Team: -1
$MessageNew:  XSTR("Heavy Raiders, two of them, low and from the stern. They're carrying torpedoes.", -1)
$end_multi_text
+Wave Name: XM-Picket-05.ogg

$Name: HQ Win
$Team: -1
$MessageNew:  XSTR("Picket line is clear. The Halyard took a few scratches and the Raiders took the worst of it. Good work.", -1)
$end_multi_text
+Wave Name: XM-Picket-06.ogg

$Name: HQ Halyard Lost
$Team: -1
$MessageNew:  XSTR("The Halyard is gone. The picket line is open. Break off and return to the fleet.", -1)
$end_multi_text
+Wave Name: XM-Picket-07.ogg

$Name: More 1
$Team: -1
$MessageNew:  XSTR("Another picket. Fleet defense is mostly waiting, isn't it?", -1)
$end_multi_text
+Wave Name: XM-Picket-08.ogg

$Name: More 2
$Team: -1
$MessageNew:  XSTR("Waiting is the part nobody tells you about when you sign up.", -1)
$end_multi_text
+Wave Name: XM-Picket-09.ogg

$Name: More 3
$Team: -1
$MessageNew:  XSTR("Halyard to Red flight, we're the first thing they hit. Make it count.", -1)
$end_multi_text
+Wave Name: XM-Picket-10.ogg

