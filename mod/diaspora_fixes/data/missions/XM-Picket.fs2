#Briefing
$start_briefing
$num_stages: 1
$start_stage
$multi_text
 XSTR("The frigate Halyard is holding a picket station at the edge of the fleet. Raiders are probing the line. Red flight screens her until the probe is over. Objectives. Keep the Halyard alive and destroy the Raiders.", -1)
$end_multi_text
$voice: XM-Picket-B-01.ogg
$camera_pos: 0.000000, 3000.000000, -9000.000000
$camera_orient:
	1.000000, 0.000000, 0.000000,
	0.000000, 0.939693, 0.342020,
	0.000000, -0.342020, 0.939693,
$camera_time: 500
$num_lines: 0
$num_icons: 0
$Flags: 1
$Formula: ( true ) 
$end_stage
$end_briefing

#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("The Raiders that probed the picket are wreckage and the Halyard is still on station. The line held.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Take the Raiders while they are busy with the frigate's flak, then turn on the Heavies before they release.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Halyard Lost" 0 )
$Multi text
    XSTR("We lost the Halyard, and with her the western picket.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Stay inside the frigate's flak and kill the Heavy Raiders before they get a torpedo run.", -1)
$end_multi_text

