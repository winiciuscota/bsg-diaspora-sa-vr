$Command Sender: Theseus

$Name: L1 NJ03
$Team: -1
$MessageNew:  XSTR("Nightjars, we've been seen. I need nine kilometres of quiet and I won't get it. Keep them off my back.", -1)
$end_multi_text
+Wave Name: XM-NJ03-01.ogg

$Name: L2 NJ03
$Team: -1
$MessageNew:  XSTR("Roost is slow. We'll make her safe.", -1)
$end_multi_text
+Wave Name: XM-NJ03-02.ogg

$Name: L3 NJ03
$Team: -1
$MessageNew:  XSTR("Scouts. Four of them, close in.", -1)
$end_multi_text
+Wave Name: XM-NJ03-03.ogg

$Name: L4 NJ03
$Team: -1
$MessageNew:  XSTR("Advanced Raiders on my left. They're fast.", -1)
$end_multi_text
+Wave Name: XM-NJ03-04.ogg

$Name: L5 NJ03
$Team: -1
