$end_multi_text
+Wave Name: XM-NJ03-05.ogg

$Name: L6 NJ03
$Team: -1
$MessageNew:  XSTR("More Raiders. They won't let go.", -1)
$end_multi_text
+Wave Name: XM-NJ03-06.ogg

$Name: L7 NJ03
$Team: -1
