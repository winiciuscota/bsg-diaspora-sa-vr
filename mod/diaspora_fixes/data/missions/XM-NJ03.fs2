+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 700 ) ( not ( is-destroyed-delay 0 "Roost" ) ) ) ( send-message "Roost" "High" "L7 NJ03" ) )
+Name: Say L7 NJ03
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 720 ) ( do-nothing ) )
+Name: Jump
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-departed-delay 3 "Roost" ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Cond" 0 ) ( send-message "#Command" "High" "W NJ03" ) )
+Name: Win Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Msg" 3 ) ( do-nothing ) )
