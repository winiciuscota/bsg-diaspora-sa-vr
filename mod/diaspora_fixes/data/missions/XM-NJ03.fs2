$end_multi_text
+Wave Name: XM-NJ03-07.ogg

$Name: W NJ03
$Team: -1
$MessageNew:  XSTR("Roost is clear and the cell has a new home. It's not much, but it's ours.", -1)
$end_multi_text
+Wave Name: XM-NJ03-08.ogg

$Name: F NJ03
$Team: -1
$MessageNew:  XSTR("Roost is gone, and with her the cell.", -1)
