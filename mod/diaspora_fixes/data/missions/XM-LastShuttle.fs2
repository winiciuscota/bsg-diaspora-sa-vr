#Events		;! 16 total

$Formula: ( when ( true ) ( do-nothing ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 3 ) ( send-message "#Command" "High" "L1 Shuttle" ) )
+Name: Say L1 Shuttle
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 20 ) ( not ( is-destroyed-delay 0 "Shuttle 1" ) ) ) ( send-message "Shuttle 1" "High" "L2 Shuttle" ) )
+Name: Say L2 Shuttle
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 65 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "L3 Shuttle" ) )
+Name: Say L3 Shuttle
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 165 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "L4 Shuttle" ) )
+Name: Say L4 Shuttle
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 285 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "L5 Shuttle" ) )
+Name: Say L5 Shuttle
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 380 ) ( send-message "#Command" "High" "L6 Shuttle" ) )
+Name: Say L6 Shuttle
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 420 ) ( do-nothing ) )
+Name: Jump
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-departed-delay 3 "Shuttle 1" ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Cond" 0 ) ( send-message "#Command" "High" "W Shuttle" ) )
+Name: Win Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Msg" 3 ) ( do-nothing ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Shuttle 1" ) ( send-message "#Command" "High" "F Shuttle" ) )
+Name: Shuttle 1 Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Shuttle 1 Lost" 8 ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

