#Messages		;! 15 total

$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("Red flight, Theseus. The pilgrim ship Pilgrim Mercy fell out of FTL inside the Ashen Veil eleven hours ago and went dark. Two hundred and twelve civilians from Gemenon Heights are aboard and her drive is cracked. Gleaner 1 is jumping in to take them off. Hold the Veil and keep that Raptor alive.", -1)
$end_multi_text
+Wave Name: XM-Vigil-01.ogg

$Name: Mercy Hail
$Team: -1
$MessageNew:  XSTR("Red flight, this is Captain Ilyra Voss of the Pilgrim Mercy. Thank the Lords. Our engines are slag and the shields are gone, but the chief thinks she can nurse the drive back if you give her a few minutes.", -1)
$end_multi_text
+Wave Name: XM-Vigil-02.ogg

$Name: S Contacts
$Team: -1
$MessageNew:  XSTR("Contacts, Red Leader! Raiders, coming in off the Veil. Gods, they were waiting for us.", -1)
$end_multi_text
+Wave Name: XM-Vigil-03.ogg

$Name: F Count
$Team: -1
$MessageNew:  XSTR("I count four. They're ignoring us, they're heading straight for the cruiser.", -1)
$end_multi_text
+Wave Name: XM-Vigil-04.ogg

$Name: Gleaner Arrive
$Team: -1
$MessageNew:  XSTR("Gleaner 1 on approach. Two minutes to dock and load. Somebody keep the Cylons off my back.", -1)
$end_multi_text
+Wave Name: XM-Vigil-05.ogg

$Name: Gleaner Dock
$Team: -1
$MessageNew:  XSTR("Docked. Loading civilians now, this is going to take a minute.", -1)
$end_multi_text
+Wave Name: XM-Vigil-06.ogg

$Name: S Advanced
$Team: -1
$MessageNew:  XSTR("More Raiders! These are fast, advanced models. Keep them off the Raptor.", -1)
$end_multi_text
+Wave Name: XM-Vigil-07.ogg

$Name: Gleaner Done
$Team: -1
$MessageNew:  XSTR("That's everyone, two hundred and twelve, babies and all. Undocking. Mercy, spool your FTL and go.", -1)
$end_multi_text
+Wave Name: XM-Vigil-08.ogg

$Name: Mercy Spool
$Team: -1
$MessageNew:  XSTR("Spooling the drive. Seventy seconds, give or take. Don't let them touch us.", -1)
$end_multi_text
+Wave Name: XM-Vigil-09.ogg

$Name: S Heavy
$Team: -1
$MessageNew:  XSTR("Heavy Raiders, two o'clock high! They're going for the engines.", -1)
$end_multi_text
+Wave Name: XM-Vigil-10.ogg

$Name: HQ Basestar
$Team: -1
$MessageNew:  XSTR("Red flight, DRADIS shows a basestar jumping in at the edge of the Veil. Your window is closing.", -1)
$end_multi_text
+Wave Name: XM-Vigil-11.ogg

$Name: Mercy Jump
$Team: -1
$MessageNew:  XSTR("Jumping! The Lords watch over you, Thunderlords.", -1)
$end_multi_text
+Wave Name: XM-Vigil-12.ogg

$Name: HQ Win
$Team: -1
$MessageNew:  XSTR("The Mercy is clear and on her way to the fleet. Outstanding work, Red flight. Come on home.", -1)
$end_multi_text
+Wave Name: XM-Vigil-13.ogg

$Name: HQ Mercy Lost
$Team: -1
$MessageNew:  XSTR("We've lost the Mercy. Gods help them. Break off and return to Theseus, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Vigil-14.ogg

$Name: HQ Gleaner Lost
$Team: -1
$MessageNew:  XSTR("Gleaner 1 is down. Without her the Mercy is stranded. Abort and return to Theseus.", -1)
$end_multi_text
+Wave Name: XM-Vigil-15.ogg

