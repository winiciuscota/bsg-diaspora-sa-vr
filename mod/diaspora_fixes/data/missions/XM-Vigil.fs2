#Events		;! 24 total

$Formula: ( when ( true ) ( ship-guardian-threshold 25 "Pilgrim Mercy" ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 3 ) ( send-message "#Command" "High" "HQ Orders" ) )
+Name: Briefing Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Briefing Msg" 22 ) ( send-message "Pilgrim Mercy" "High" "Mercy Hail" ) )
+Name: Mercy Hail Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Mercy Hail Msg" 14 ) ( do-nothing ) )
+Name: Alpha Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 4 "Alpha" ) ( send-message "Red 2" "High" "S Contacts" ) )
+Name: Alpha Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 10 "Alpha" ) ( send-message "Red 3" "High" "F Count" ) )
+Name: Alpha Msg 2
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 2 "Gleaner 1" ) ( send-message "Gleaner 1" "High" "Gleaner Arrive" ) )
+Name: Gleaner Arrive Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 130 ) ( send-message "Gleaner 1" "High" "Gleaner Dock" ) )
+Name: Gleaner On Station
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Gleaner On Station" 8 ) ( do-nothing ) )
+Name: Bravo Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 4 "Bravo" ) ( send-message "Red 2" "High" "S Advanced" ) )
+Name: Bravo Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Gleaner On Station" 75 ) ( send-message "Gleaner 1" "High" "Gleaner Done" ) )
+Name: Transfer Done
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Transfer Done" 4 ) ( send-message "Pilgrim Mercy" "High" "Mercy Spool" ) )
+Name: Mercy Spool
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Mercy Spool" 30 ) ( ship-no-guardian "Pilgrim Mercy" ) )
+Name: Guard Off
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Transfer Done" 14 ) ( do-nothing ) )
+Name: Charlie Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 4 "Charlie" ) ( send-message "Red 2" "High" "S Heavy" ) )
+Name: Charlie Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Pyre" ) ( send-message "#Command" "High" "HQ Basestar" ) )
+Name: Pyre Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Mercy Spool" 66 ) ( send-message "Pilgrim Mercy" "High" "Mercy Jump" ) )
+Name: Mercy Jump Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-departed-delay 3 "Pilgrim Mercy" ) ( send-message "#Command" "High" "HQ Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Pilgrim Mercy" ) ( send-message "#Command" "High" "HQ Mercy Lost" ) )
+Name: Mercy Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Gleaner 1" ) ( send-message "#Command" "High" "HQ Gleaner Lost" ) )
+Name: Gleaner Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Mercy Lost" 8 ) ( is-event-true-delay "Gleaner Lost" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

#Goals		;! 3 total

$Type: Primary
+Name: Protect Pilgrim Mercy
$MessageNew:  XSTR("Protect the Pilgrim Mercy until she jumps", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Primary
+Name: Escort Gleaner 1
$MessageNew:  XSTR("Keep Gleaner 1 alive while she loads the survivors", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Transfer Done" 0 )
+Score: 100

$Type: Secondary
+Name: Destroy Raiders
$MessageNew:  XSTR("Destroy the Cylon raiders", -1)
$end_multi_text
$Formula: ( percent-ships-destroyed 75 "Alpha" "Bravo" "Charlie" )
+Score: 50

