#Debriefing_info

$Num stages: 3

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Two hundred and twelve people are alive because you held the Veil. Captain Voss has already asked which squadron to thank. The Pilgrim Mercy reaches the fleet tomorrow, and the Cylon basestar will not be reaching anyone for a while. Well done, Thunderlords.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Raiders go for the engines first. Shoot them off the cruiser's tail before they get a lock.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Mercy Lost" 0 )
$Multi text
    XSTR("We lost the Mercy and everyone aboard her. The Cylons knew exactly where she was and they were patient. Learn from it. We cannot afford to lose another one.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Stay between the raiders and the cruiser. Use your missiles on the Heavy Raiders, they absorb a lot of cannon fire.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Gleaner Lost" 0 )
$Multi text
    XSTR("Gleaner 1 never made it out and the Mercy is stranded in the Veil without her. The Raptor is the only way those civilians were getting off that ship.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Intercept the first raider wave early, before the Raptor arrives. She has no guns.", -1)
$end_multi_text

#Callsigns:
