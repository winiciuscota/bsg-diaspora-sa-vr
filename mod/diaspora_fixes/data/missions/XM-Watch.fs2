#Messages		;! 26 total

$Command Sender: Theseus

$Name: L Orders
$Team: -1
$MessageNew:  XSTR("Red flight, Halyard and Cassia hold station at the western picket. Cassia needs thirty minutes of pumping, and the Cylons will smell it on the wind. Nobody leaves until she's full.", -1)
$end_multi_text
+Wave Name: XM-Watch-01.ogg

$Name: L Cassia
$Team: -1
$MessageNew:  XSTR("Cassia, pumps are running. Thirty-two minutes on my gauge, I'm sorry. I'll shout the moment it's done.", -1)
$end_multi_text
+Wave Name: XM-Watch-02.ogg

$Name: L Halyard
$Team: -1
$MessageNew:  XSTR("Halyard here, flak is up and the gunners are fresh. Red leader, keep them off Cassia's flanks.", -1)
$end_multi_text
+Wave Name: XM-Watch-03.ogg

$Name: L Scout
$Team: -1
$MessageNew:  XSTR("Four Raiders, bearing zero three zero. Probing the line, they want to see how hard we hit back.", -1)
$end_multi_text
+Wave Name: XM-Watch-04.ogg

$Name: L Fang
$Team: -1
$MessageNew:  XSTR("More company from the north! They're coming for Cassia this time.", -1)
$end_multi_text
+Wave Name: XM-Watch-05.ogg

$Name: L Maul
$Team: -1
$MessageNew:  XSTR("Heavy Raiders on the stern, torpedo profile. All batteries, tracking!", -1)
$end_multi_text
+Wave Name: XM-Watch-06.ogg

$Name: L Pumps 1
$Team: -1
$MessageNew:  XSTR("Pumps are at thirty percent. If you can keep it quiet for a few minutes, it would be nice.", -1)
$end_multi_text
+Wave Name: XM-Watch-07.ogg

$Name: L Blue In
$Team: -1
$MessageNew:  XSTR("Ghost and Rook on station. Command sent us to hold the line with you.", -1)
$end_multi_text
+Wave Name: XM-Watch-08.ogg

$Name: L Wisp
$Team: -1
$MessageNew:  XSTR("Advanced models, fast ones. They're trying to cut around the back of the Halyard.", -1)
$end_multi_text
+Wave Name: XM-Watch-09.ogg

$Name: L Halyard Hit
$Team: -1
$MessageNew:  XSTR("Taking hits on the dorsal plating, nothing structural. Keep them off our engines, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Watch-10.ogg

$Name: L Basestar
$Team: -1
$MessageNew:  XSTR("DRADIS, basestar! One of theirs has jumped in thirty kilometres out and is launching. Halyard, hold your position.", -1)
$end_multi_text
+Wave Name: XM-Watch-11.ogg

$Name: L Pumps 2
$Team: -1
$MessageNew:  XSTR("Sixty percent. Please tell me I don't have to disconnect.", -1)
$end_multi_text
+Wave Name: XM-Watch-12.ogg

$Name: L Horde
$Team: -1
$MessageNew:  XSTR("Six Raiders off the basestar. They're all over us!", -1)
$end_multi_text
+Wave Name: XM-Watch-13.ogg

$Name: L Hammer
$Team: -1
$MessageNew:  XSTR("Four Heavy Raiders breaking from the basestar, straight for Cassia! Red flight, get on them!", -1)
$end_multi_text
+Wave Name: XM-Watch-14.ogg

$Name: L Hammer Down
$Team: -1
$MessageNew:  XSTR("Got one! Keep going, they're the ones with the torpedoes.", -1)
$end_multi_text
+Wave Name: XM-Watch-15.ogg

$Name: L Pumps 3
$Team: -1
$MessageNew:  XSTR("Ninety percent! Ten more minutes and I can jump. Hold on to me, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Watch-16.ogg

$Name: L Dusk
$Team: -1
$MessageNew:  XSTR("Last of the escorts coming around, I count eight. Everything we have, now!", -1)
$end_multi_text
+Wave Name: XM-Watch-17.ogg

$Name: L Full
$Team: -1
$MessageNew:  XSTR("Tanks full! Spooling the drive. Thank you, Red flight, thank you.", -1)
$end_multi_text
+Wave Name: XM-Watch-18.ogg

$Name: L Win
$Team: -1
$MessageNew:  XSTR("Cassia and Halyard are away with a full load of tylium. Half an hour on station and nobody lost. Excellent work, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Watch-19.ogg

$Name: L Lost
$Team: -1
$MessageNew:  XSTR("We lost the station. Break off and fall back to the fleet.", -1)
$end_multi_text
+Wave Name: XM-Watch-20.ogg

$Name: More 1
$Team: -1
$MessageNew:  XSTR("Half an hour on a picket. I've never been so grateful for coffee.", -1)
$end_multi_text
+Wave Name: XM-Watch-21.ogg

$Name: More 2
$Team: -1
$MessageNew:  XSTR("Every minute they don't attack is a minute we get ready for the next one.", -1)
$end_multi_text
+Wave Name: XM-Watch-22.ogg

$Name: More 3
$Team: -1
$MessageNew:  XSTR("Cassia to escort, the tanker's feeding the fleet. Keep the lanes clear.", -1)
$end_multi_text
+Wave Name: XM-Watch-23.ogg

$Name: More 4
$Team: -1
$MessageNew:  XSTR("Halyard to Red flight, the waves are getting bigger. Pace yourselves.", -1)
$end_multi_text
+Wave Name: XM-Watch-24.ogg

$Name: More 5
$Team: -1
$MessageNew:  XSTR("Theseus to Red flight, I've watched pickets like this break. Yours won't.", -1)
$end_multi_text
+Wave Name: XM-Watch-25.ogg

$Name: More 6
$Team: -1
$MessageNew:  XSTR("If we make it through this, I'm sleeping for a week.", -1)
$end_multi_text
+Wave Name: XM-Watch-26.ogg

