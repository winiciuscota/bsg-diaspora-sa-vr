#Command Briefing

#Briefing
$start_briefing
$num_stages: 1
$start_stage
$multi_text
 XSTR("The tanker Cassia needs half an hour at the Halyard's picket station to top up the fleet's reserves, and the Cylons will find out. Red flight holds the station through six waves until Cassia's pumps are done and both ships can jump. Objectives. Keep Cassia and the Halyard alive until they jump. Destroy the Cylon attack waves.", -1)
$end_multi_text
$voice: XM-Watch-B-01.ogg
$camera_pos: 0.000000, 3000.000000, -9000.000000
$camera_orient:
	1.000000, 0.000000, 0.000000,
	0.000000, 0.939693, 0.342020,
	0.000000, -0.342020, 0.939693,
$camera_time: 500
$num_lines: 0
$num_icons: 0
$Flags: 1
$Formula: ( true ) 
$end_stage
$end_briefing

#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Thirty minutes of pumping, six Cylon waves and a basestar, and Cassia jumped with her tanks full. The reserve is safe.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Kill the Heavy Raiders first, every wave after the second tries to reach the tanker.", -1)
$end_multi_text

$Formula: ( or ( is-event-true-delay "Cassia Lost" 0 ) ( is-event-true-delay "Halyard Lost" 0 ) )
$Multi text
    XSTR("The station fell and the tylium with it. The reserve will be short this month.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Keep your wing close to Cassia and take the Heavy Raiders before they release their torpedoes.", -1)
$end_multi_text

