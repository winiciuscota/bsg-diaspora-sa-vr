#Goals		;! 3 total

$Type: Primary
+Name: Hold the station
$MessageNew:  XSTR("Keep Cassia and the Halyard alive until they jump", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Primary
+Name: Break the waves
$MessageNew:  XSTR("Destroy the Cylon attack waves", -1)
$end_multi_text
$Formula: ( percent-ships-destroyed 70 "Scout" "Fang" "Maul" "Wisp" "Horde" "Hammer" "Dusk" "Last" )
+Score: 100

$Type: Bonus
+Name: Sink the Nemesis escorts
$MessageNew:  XSTR("Destroy all four Heavy Raiders of the Hammer wing", -1)
$end_multi_text
$Formula: ( is-destroyed-delay 0 "Hammer 1" "Hammer 2" "Hammer 3" "Hammer 4" )
+Score: 40

