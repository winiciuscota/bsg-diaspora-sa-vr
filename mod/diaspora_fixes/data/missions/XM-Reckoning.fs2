$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("Red flight, four cargo pods are drifting at the relay. Fly close to each one and scan it. We need the antibiotics. When you find them, Lantern 3 will come and haul the pod home.", -1)
$end_multi_text
+Wave Name: XM-Reckoning-01.ogg

$Name: F Scan
$Team: -1
$MessageNew:  XSTR("Scanning takes a few seconds at close range. Target a pod and hold steady next to it.", -1)
$end_multi_text
+Wave Name: XM-Reckoning-02.ogg

