#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("The antibiotics are aboard Theseus and on their way to the fleet's sickbays. The doctors say you just saved more lives than any dogfight this month. Well done.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Scan the pods quickly. The Cylons send more ships the longer you stay at the relay.", -1)
$end_multi_text

$Formula: ( or ( is-event-true-delay "Lantern Lost" 0 ) ( is-event-true-delay "Pod Lost" 0 ) )
$Multi text
    XSTR("We lost the antibiotics. People in the fleet will die of infections we know how to cure.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Stay with the Raptor once she arrives. The Heavy Raiders come late and go straight for her.", -1)
$end_multi_text

#Callsigns:
$Callsign: Shadow
$Callsign: Flask

#end


