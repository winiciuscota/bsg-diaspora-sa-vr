#Events		;! 22 total

$Formula: ( when ( true ) ( send-message "#Command" "High" "HQ Orders" ) )
+Name: Orders Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Orders Msg" 14 ) ( send-message "Red 2" "High" "F Scan" ) )
+Name: Scan Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Scan Msg" 25 ) ( do-nothing ) )
+Name: Scav Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Scav" ) ( send-message "Red 3" "High" "S Scavs" ) )
+Name: Scav Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-cargo-known-delay 0 "Pod Charlie" ) ( send-message "Red 2" "High" "F Found" ) )
+Name: Found
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 2 "Lantern 3" ) ( send-message "Lantern 3" "High" "Lantern Hail" ) )
+Name: Lantern Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Vulture" ) ( send-message "Red 3" "High" "S Vultures" ) )
+Name: Vulture Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Hauler" ) ( send-message "Red 2" "High" "S Haulers" ) )
+Name: Hauler Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 75 "Lantern 3" ) ( send-message "Lantern 3" "High" "Lantern Done" ) )
+Name: Lantern Out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-departed-delay 3 "Lantern 3" ) ( send-message "#Command" "High" "HQ Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Lantern 3" ) ( send-message "#Command" "High" "HQ Lantern Lost" ) )
+Name: Lantern Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Pod Charlie" ) ( send-message "#Command" "High" "HQ Pod Lost" ) )
+Name: Pod Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Lantern Lost" 8 ) ( is-event-true-delay "Pod Lost" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Scan Msg" 10 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 1" ) )
+Name: Chatter 1 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Scav Msg" 14 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 2" ) )
+Name: Chatter 2 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Found" 6 ) ( send-message "#Command" "Normal" "Chatter 3" ) )
+Name: Chatter 3 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Lantern Msg" 12 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "Normal" "Chatter 4" ) )
+Name: Chatter 4 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Hauler Msg" 10 ) ( not ( is-destroyed-delay 0 "Lantern 3" ) ) ) ( send-message "Lantern 3" "Normal" "Chatter 5" ) )
+Name: Chatter 5 Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Lantern Out" 2 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "Normal" "Chatter 6" ) )
+Name: Chatter 6 Msg
