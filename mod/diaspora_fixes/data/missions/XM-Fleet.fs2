#Messages		;! 3 total

$Command Sender: Theseus

$Name: HQ Welcome
$Team: -1
$MessageNew:  XSTR("Red 1, Theseus. Nothing on DRADIS and no orders. The fleet is yours to look at. Fly around, stretch the Viper's legs. Jump out whenever you want.", -1)
$end_multi_text
+Wave Name: XM-Fleet-01.ogg

$Name: HQ Landing
$Team: -1
$MessageNew:  XSTR("Red 1, Theseus. If you want to come home, take a landing bay on either side of the Theseus or the rear bay of the Prometheus. Bring your speed under forty and set her down. We'll catch you.", -1)
$end_multi_text

$Name: HQ Down
$Team: -1
$MessageNew:  XSTR("Red 1, you're down. Welcome back aboard. Deck crew will take it from here.", -1)
$end_multi_text

