#Events		;! 6 total

$Formula: ( when ( true ) ( send-message "#Command" "High" "HQ Welcome" ) )
+Name: Welcome Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Welcome Msg" 40 ) ( send-message "#Command" "Low" "HQ Landing" ) )
+Name: Landing Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( < ( current-speed "Red 1" ) 45 ) ( or ( < ( distance "Red 1" "Deck Port:1" ) 70 ) ( < ( distance "Red 1" "Deck Starboard:1" ) 70 ) ( < ( distance "Red 1" "Deck Prometheus:1" ) 45 ) ) ) ( do-nothing ) )
+Name: Landed
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Landed" 1 ) ( send-message "#Command" "High" "HQ Down" ) )
+Name: Landed Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Landed" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

#Goals		;! 3 total

$Type: Secondary
+Name: Fly around the fleet
$MessageNew:  XSTR("Fly past the battlestar, the frigate and the tanker (optional)", -1)
$end_multi_text
$Formula: ( or ( < ( distance "Red 1" "Theseus" ) 600 ) ( < ( distance "Red 1" "Sabazius" ) 400 ) ( < ( distance "Red 1" "Prometheus" ) 400 ) )
+Score: 10

$Type: Secondary
+Name: Land on a carrier
$MessageNew:  XSTR("Touch down in a landing bay of the Theseus or the Prometheus below forty-five metres per second (ends the mission)", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Landed" 0 )
+Score: 10

$Type: Secondary
+Name: Target practice
$MessageNew:  XSTR("Shoot the four parked training drones to the east (optional)", -1)
$end_multi_text
$Formula: ( is-destroyed-delay 0 "Drone 1" "Drone 2" "Drone 3" "Drone 4" )
+Score: 10

