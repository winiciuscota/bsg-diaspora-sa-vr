$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Pilgrim Mercy is through with her passengers and the Halyard is intact. Slow ships win by having a good escort.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Kill the Raiders before they reach the mover, the Heavies are the real threat to her engines.", -1)
$end_multi_text

$Formula: ( or ( is-event-true-delay "Mercy Lost" 0 ) ( is-event-true-delay "Halyard Lost" 0 ) )
$Multi text
    XSTR("We lost the tow. Slow ships do not survive slow escorts.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Intercept the Raiders ahead of the mover and keep your eyes on the Heavy Raiders in the stern.", -1)
$end_multi_text

