#Events		;! 19 total

$Formula: ( when ( true ) ( ship-guardian-threshold 20 "Halyard" "Pilgrim Mercy" ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 2 ) ( send-message "#Command" "High" "HQ Orders" ) )
+Name: Orders Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Orders Msg" 12 ) ( send-message "Pilgrim Mercy" "High" "Mercy Hail" ) )
+Name: Mercy Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Mercy Msg" 25 ) ( do-nothing ) )
+Name: Hawk Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Hawk" ) ( send-message "Red 3" "High" "Hawk Contact" ) )
+Name: Hawk Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 14 "Hawk" ) ( send-message "Halyard" "High" "Halyard Cover" ) )
+Name: Cover Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Hawk Cue" 70 ) ( do-nothing ) )
+Name: Mauler Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Mauler" ) ( send-message "Red 2" "High" "Mauler Contact" ) )
+Name: Mauler Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Mauler Cue" 55 ) ( do-nothing ) )
+Name: Kite Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-arrived-delay 3 "Kite" ) ( send-message "Red 3" "High" "Kite Contact" ) )
+Name: Kite Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Kite Msg" 55 ) ( send-message "Pilgrim Mercy" "High" "Mercy Ready" ) )
+Name: Drive Ready
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Drive Ready" 2 ) ( do-nothing ) )
+Name: Tow Jump
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( has-departed-delay 2 "Pilgrim Mercy" ) ( send-message "#Command" "High" "HQ Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Pilgrim Mercy" ) ( send-message "#Command" "High" "HQ Mercy Lost" ) )
+Name: Mercy Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Halyard" ) ( send-message "#Command" "High" "HQ Halyard Lost" ) )
+Name: Halyard Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Mercy Lost" 8 ) ( is-event-true-delay "Halyard Lost" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

#Goals		;! 3 total

$Type: Primary
+Name: Get the mover out
$MessageNew:  XSTR("Keep Pilgrim Mercy alive until she jumps", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Primary
+Name: Keep the Halyard
$MessageNew:  XSTR("The Halyard must survive", -1)
$end_multi_text
$Formula: ( not ( is-destroyed-delay 0 "Halyard" ) )
+Score: 50

$Type: Bonus
+Name: No torpedo hits
$MessageNew:  XSTR("Destroy both Heavy Raiders", -1)
$end_multi_text
$Formula: ( is-destroyed-delay 0 "Mauler 1" "Mauler 2" )
+Score: 30

