#Messages		;! 10 total

$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("Red flight, Pilgrim Mercy has no FTL and she's doing all of nine hundred metres a minute. The Halyard is riding with her. Keep the Cylons off until the drive comes back.", -1)
$end_multi_text
+Wave Name: XM-Tow-01.ogg

$Name: Mercy Hail
$Team: -1
$MessageNew:  XSTR("Pilgrim Mercy. Engineers say ten minutes to bring the drive up. We don't have ten minutes, do we?", -1)
$end_multi_text
+Wave Name: XM-Tow-02.ogg

$Name: Hawk Contact
$Team: -1
$MessageNew:  XSTR("Raiders! Four of them, bearing two seven zero. They're going for the mover.", -1)
$end_multi_text
+Wave Name: XM-Tow-03.ogg

$Name: Halyard Cover
$Team: -1
$MessageNew:  XSTR("Halyard to Mercy, stay on the lane. Red flight, kill them before they reach her hull.", -1)
$end_multi_text
+Wave Name: XM-Tow-04.ogg

$Name: Mauler Contact
$Team: -1
$MessageNew:  XSTR("Heavy Raiders from the stern! They want her engines.", -1)
$end_multi_text
+Wave Name: XM-Tow-05.ogg

$Name: Kite Contact
$Team: -1
$MessageNew:  XSTR("Advanced Raiders ahead. They are circling to cut us off.", -1)
$end_multi_text
+Wave Name: XM-Tow-06.ogg

$Name: Mercy Ready
$Team: -1
$MessageNew:  XSTR("Drive's up! Jumping in ten seconds. Thank you, Red flight, thank you all.", -1)
$end_multi_text
+Wave Name: XM-Tow-07.ogg

