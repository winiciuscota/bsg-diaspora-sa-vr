#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Four pilots who would have died in the debris are alive tonight. The deck crew will remember it.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Stay between the Raptor and the next wave, not on top of her.", -1)
$end_multi_text

$Formula: ( is-event-true-delay "Lifeline Lost" 0 )
$Multi text
    XSTR("A rescue is only as good as its escort. We lost the Raptor or a pilot.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Stay between the Raptor and the next wave, not on top of her.", -1)
$end_multi_text

