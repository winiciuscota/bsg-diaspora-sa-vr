$Arrival Location: Hyperspace
$Arrival Cue: ( is-event-true-delay "Start" 260 )
$Departure Location: Hyperspace
$Departure Cue: ( false )
$Ships: (		;! 4 total
	"Sting 1"
	"Sting 2"
	"Sting 3"
	"Sting 4"
)
$AI Goals: ( goals ( ai-chase-any 60 ) )
+Flags: ( "no-arrival-music" "no-arrival-message" "no-arrival-warp" )

#Events		;! 17 total

$Formula: ( when ( true ) ( do-nothing ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 3 ) ( send-message "#Command" "High" "L1 Intercept" ) )
+Name: Say L1 Intercept
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 35 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "L2 Intercept" ) )
+Name: Say L2 Intercept
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 100 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "L3 Intercept" ) )
+Name: Say L3 Intercept
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 260 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "L4 Intercept" ) )
+Name: Say L4 Intercept
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 400 ) ( send-message "#Command" "High" "L5 Intercept" ) )
+Name: Say L5 Intercept
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 440 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "L6 Intercept" ) )
+Name: Say L6 Intercept
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 0 "Runner 1" "Runner 2" "Runner 3" "Runner 4" "Runner 5" "Runner 6" ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 480 ) ( do-nothing ) )
+Name: Escape
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Cond" 0 ) ( send-message "#Command" "High" "W Intercept" ) )
+Name: Win Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Msg" 3 ) ( do-nothing ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( has-departed-delay 1 "Runner 1" "Runner 2" "Runner 3" "Runner 4" "Runner 5" "Runner 6" ) ( has-departed-delay 1 "Runner 1" ) ) ( send-message "#Command" "High" "F Intercept" ) )
+Name: Escaped
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Red 1" ) ( send-message "#Command" "High" "F Intercept" ) )
+Name: Red Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Escaped" 8 ) ( is-event-true-delay "Red Lost" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

