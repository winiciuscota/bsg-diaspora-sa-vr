$Command Sender: Theseus

$Name: L1 Hunt
$Team: -1
$MessageNew:  XSTR("Red flight, a lone basestar is out there and she knows we're here. Kill her.", -1)
$end_multi_text
+Wave Name: XM-Basestar-01.ogg

$Name: L2 Hunt
$Team: -1
$MessageNew:  XSTR("Basestar at eleven, range ten kilometres. Raiders ahead of her.", -1)
$end_multi_text
+Wave Name: XM-Basestar-02.ogg

$Name: L3 Hunt
$Team: -1
$MessageNew:  XSTR("Raiders on our nose. Lock and shoot.", -1)
$end_multi_text
+Wave Name: XM-Basestar-03.ogg

$Name: L4 Hunt
$Team: -1
$MessageNew:  XSTR("Heavies launching. Nukes!", -1)
$end_multi_text
+Wave Name: XM-Basestar-04.ogg

$Name: L5 Hunt
$Team: -1
$MessageNew:  XSTR("Advanced Raiders from the left. They're quick.", -1)
$end_multi_text
+Wave Name: XM-Basestar-05.ogg

$Name: L6 Hunt
$Team: -1
$MessageNew:  XSTR("Keep the pressure on. We can't let her run.", -1)
$end_multi_text
+Wave Name: XM-Basestar-06.ogg

$Name: L7 Hunt
$Team: -1
$MessageNew:  XSTR("Her hull is cracking. A few more passes.", -1)
$end_multi_text
+Wave Name: XM-Basestar-07.ogg

