#Messages		;! 9 total

$Command Sender: Theseus

$Name: L1 NJ01
$Team: -1
$MessageNew:  XSTR("Nightjars, Roost. You are not on any roster and those assault Vipers are not in any hangar log. The fleet is far away and nobody is coming. We hurt them anyway.", -1)
$end_multi_text
+Wave Name: XM-NJ01-01.ogg

$Name: L2 NJ01
$Team: -1
$MessageNew:  XSTR("Shadow here. Three Movers, two Raiders. I'll take the Raiders.", -1)
$end_multi_text
+Wave Name: XM-NJ01-02.ogg

$Name: L3 NJ01
$Team: -1
$MessageNew:  XSTR("In and out. Don't get greedy, Lead.", -1)
$end_multi_text
+Wave Name: XM-NJ01-03.ogg

$Name: L4 NJ01
$Team: -1
$MessageNew:  XSTR("Lead, they heard that. Wrap it up.", -1)
$end_multi_text
+Wave Name: XM-NJ01-04.ogg

$Name: L5 NJ01
$Team: -1
$MessageNew:  XSTR("Break contact, break contact. Back to the rocks.", -1)
$end_multi_text
+Wave Name: XM-NJ01-05.ogg

$Name: Alarm NJ01
$Team: -1
$MessageNew:  XSTR("Alarm! They've got a call out. Six Raiders on the way. Finish and leave.", -1)
$end_multi_text
+Wave Name: XM-NJ01-06.ogg

$Name: Clear NJ01
$Team: -1
$MessageNew:  XSTR("Targets down. Break contact, Nightjars. Out through the rocks, don't fly the straight line.", -1)
$end_multi_text
+Wave Name: XM-NJ01-07.ogg

$Name: W NJ01
$Team: -1
$MessageNew:  XSTR("Clean strike, clean exit. The anchorage is burning and nobody knows where we are.", -1)
$end_multi_text
+Wave Name: XM-NJ01-08.ogg

$Name: F NJ01
$Team: -1
$MessageNew:  XSTR("The strike failed and the cell has been seen. Roost is moving.", -1)
$end_multi_text
+Wave Name: XM-NJ01-09.ogg

