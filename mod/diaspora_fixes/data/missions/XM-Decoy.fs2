#Events		;! 16 total

$Formula: ( when ( true ) ( do-nothing ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 3 ) ( send-message "#Command" "High" "L1 Decoy" ) )
+Name: Say L1 Decoy
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 25 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "L2 Decoy" ) )
+Name: Say L2 Decoy
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 150 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "L3 Decoy" ) )
+Name: Say L3 Decoy
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 330 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "L4 Decoy" ) )
+Name: Say L4 Decoy
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 520 ) ( send-message "#Command" "High" "L5 Decoy" ) )
+Name: Say L5 Decoy
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 640 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "L6 Decoy" ) )
+Name: Say L6 Decoy
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 0 "Heavy 1" "Heavy 2" "Heavy 3" "Heavy 4" ) ( do-nothing ) )
+Name: Win Cond
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Cond" 0 ) ( send-message "#Command" "High" "W Decoy" ) )
+Name: Win Msg
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win Msg" 3 ) ( do-nothing ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 900 ) ( send-message "#Command" "High" "F Decoy" ) )
+Name: Out Of Time
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Red 1" ) ( send-message "#Command" "High" "F Decoy" ) )
+Name: Red Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Out Of Time" 8 ) ( is-event-true-delay "Red Lost" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

