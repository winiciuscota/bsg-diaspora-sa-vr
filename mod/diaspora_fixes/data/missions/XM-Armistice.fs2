$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Armistice Station held for half an hour. Seven hundred refugees are on their way to the fleet, and the Theseus is in the field.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Every wave goes for a different target. Learn them and meet them early.", -1)
$end_multi_text

$Formula: ( or ( is-event-true-delay "Armistice Lost" 0 ) ( is-event-true-delay "Allsop Lost" 0 ) ( is-event-true-delay "Keplaw Lost" 0 ) ( is-event-true-delay "Pixie Lost" 0 ) ( is-event-true-delay "Halyard Lost" 0 ) )
$Multi text
    XSTR("The station fell, and the people who were still aboard went with it.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Kill the Heavy Raiders first. They go for the movers.", -1)
$end_multi_text

