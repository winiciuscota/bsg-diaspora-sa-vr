#Goals		;! 3 total

$Type: Primary
+Name: Hold Armistice
$MessageNew:  XSTR("Keep the station and the three movers alive until the last has jumped", -1)
$end_multi_text
$Formula: ( is-event-true-delay "Win" 0 )
+Score: 100

$Type: Primary
+Name: Keep the Halyard
$MessageNew:  XSTR("The Halyard must survive", -1)
$end_multi_text
$Formula: ( not ( is-destroyed-delay 0 "Halyard" ) )
+Score: 50

$Type: Bonus
+Name: Sink both basestars
$MessageNew:  XSTR("Destroy Ironhand and Vulture with the Theseus", -1)
$end_multi_text
$Formula: ( and ( is-destroyed-delay 0 "Ironhand" ) ( is-destroyed-delay 0 "Vulture" ) )
+Score: 60

#Waypoints		;! 0 lists total

#Messages		;! 18 total

$Command Sender: Theseus

$Name: A Orders
$Team: -1
$MessageNew:  XSTR("Red flight, Armistice Station is the last port before the fleet. The movers load for thirty minutes and then jump, one by one. The Theseus is on her way, but she won't be here for twenty. Hold the station.", -1)
$end_multi_text
+Wave Name: XM-Armistice-01.ogg

$Name: A Allsop
$Team: -1
$MessageNew:  XSTR("Allsop, loading refugees. Two hundred and eighty, then I'm out. Thank you for being here.", -1)
$end_multi_text
+Wave Name: XM-Armistice-02.ogg

$Name: A Halyard
$Team: -1
$MessageNew:  XSTR("Halyard, taking position over the main docks. If they come for the station, they come through us.", -1)
$end_multi_text
+Wave Name: XM-Armistice-03.ogg

$Name: A Snap
$Team: -1
$MessageNew:  XSTR("Raiders, four of them, straight for Allsop. Cover the mover!", -1)
$end_multi_text
+Wave Name: XM-Armistice-04.ogg

$Name: A Talon
$Team: -1
$MessageNew:  XSTR("Heavy Raiders on the dorsal side! They're going for the station itself!", -1)
$end_multi_text
+Wave Name: XM-Armistice-05.ogg

$Name: A Allsop Go
$Team: -1
$MessageNew:  XSTR("Allsop is full! Jumping. Please keep the others safe.", -1)
$end_multi_text
+Wave Name: XM-Armistice-06.ogg

$Name: A Wasp
$Team: -1
$MessageNew:  XSTR("Advanced Raiders, five, from the sunward side! They're fast!", -1)
$end_multi_text
+Wave Name: XM-Armistice-07.ogg

$Name: A Blue
$Team: -1
$MessageNew:  XSTR("Ghost and Rook in the fight. Sorry we're late, Red leader.", -1)
$end_multi_text
+Wave Name: XM-Armistice-08.ogg

$Name: A Basestar
$Team: -1
$MessageNew:  XSTR("DRADIS, basestar! One of theirs, dead ahead! Everyone, hold your positions!", -1)
$end_multi_text
+Wave Name: XM-Armistice-09.ogg

$Name: A Keplaw
$Team: -1
$MessageNew:  XSTR("Keplaw, loading at the lower docks. We saw the basestar. Two more minutes!", -1)
$end_multi_text
+Wave Name: XM-Armistice-10.ogg

$Name: A Keplaw Go
$Team: -1
$MessageNew:  XSTR("Keplaw away! Thank you, Red flight. Two hundred more of us are alive.", -1)
$end_multi_text
+Wave Name: XM-Armistice-11.ogg

$Name: A Hook
$Team: -1
$MessageNew:  XSTR("Four Heavy Raiders breaking for the movers! Red flight, get on them!", -1)
$end_multi_text
+Wave Name: XM-Armistice-12.ogg

$Name: A Gale
$Team: -1
$MessageNew:  XSTR("Six Advanced Raiders from the high side, that's their best wave yet.", -1)
$end_multi_text
+Wave Name: XM-Armistice-13.ogg

$Name: A Vulture
$Team: -1
$MessageNew:  XSTR("A second basestar! Armistice Station, hold on, Theseus is thirty seconds out!", -1)
$end_multi_text
+Wave Name: XM-Armistice-14.ogg

$Name: A Theseus
$Team: -1
$MessageNew:  XSTR("Theseus on station! All batteries, firing! Red flight, you are not alone any more!", -1)
$end_multi_text
+Wave Name: XM-Armistice-15.ogg

$Name: A Pixie Go
$Team: -1
$MessageNew:  XSTR("Pixie is loaded, the last one. Jumping! Thank you, all of you.", -1)
$end_multi_text
+Wave Name: XM-Armistice-16.ogg

$Name: A Win
$Team: -1
$MessageNew:  XSTR("All three movers are away and the station still stands. The Theseus has the field. Outstanding work, Red flight. You held Armistice.", -1)
$end_multi_text
+Wave Name: XM-Armistice-17.ogg

$Name: A Lost
$Team: -1
$MessageNew:  XSTR("Armistice Station is lost. Fall back to the fleet.", -1)
$end_multi_text
+Wave Name: XM-Armistice-18.ogg

