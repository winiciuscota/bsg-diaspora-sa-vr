#Events		;! 31 total

$Formula: ( when ( true ) ( ship-guardian-threshold 20 "Halyard" "Tern" "Briony" "Aster" ) )
+Name: Start
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 2 ) ( send-message "#Command" "High" "C Orders" ) )
+Name: Say C Orders
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 16 ) ( not ( is-destroyed-delay 0 "Aster" ) ) ) ( send-message "Aster" "High" "C Aster" ) )
+Name: Say C Aster
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Start" 30 ) ( not ( is-destroyed-delay 0 "Tern" ) ) ) ( send-message "Tern" "High" "C Tern" ) )
+Name: Say C Tern
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 420 ) ( do-nothing ) )
+Name: Blue Cue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Start" 100 ) ( do-nothing ) )
+Name: Wave 1
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 1" 6 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "C Hawk" ) )
+Name: Say C Hawk
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 1" 220 ) ( percent-ships-destroyed 75 "Hawk" ) ) ( do-nothing ) )
+Name: Wave 2
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 2" 6 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "High" "C Mauler" ) )
+Name: Say C Mauler
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 2" 240 ) ( percent-ships-destroyed 75 "Mauler" ) ) ( do-nothing ) )
+Name: Wave 3
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 3" 5 ) ( not ( is-destroyed-delay 0 "Red 2" ) ) ) ( send-message "Red 2" "High" "C Pincer" ) )
+Name: Say C Pincer
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 3" 70 ) ( not ( is-destroyed-delay 0 "Blue 1" ) ) ) ( send-message "Blue 1" "High" "C Blue" ) )
+Name: Say C Blue
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 3" 260 ) ( percent-ships-destroyed 75 "Kite" "Fury" ) ) ( do-nothing ) )
+Name: Wave 4
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Wave 4" 4 ) ( send-message "#Command" "High" "C Basestar" ) )
+Name: Say C Basestar
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 4" 40 ) ( not ( is-destroyed-delay 0 "Briony" ) ) ) ( send-message "Briony" "High" "C Briony" ) )
+Name: Say C Briony
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 4" 260 ) ( percent-ships-destroyed 75 "Swarm" ) ) ( do-nothing ) )
+Name: Wave 5
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 5" 5 ) ( not ( is-destroyed-delay 0 "Halyard" ) ) ) ( send-message "Halyard" "High" "C Talon" ) )
+Name: Say C Talon
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 5" 210 ) ( percent-ships-destroyed 75 "Talon" ) ) ( do-nothing ) )
+Name: Wave 6
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 6" 4 ) ( not ( is-destroyed-delay 0 "Red 3" ) ) ) ( send-message "Red 3" "High" "C Dust" ) )
+Name: Say C Dust
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Wave 6" 150 ) ( percent-ships-destroyed 75 "Dust" ) ) ( do-nothing ) )
+Name: Drive Ready
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( is-event-true-delay "Drive Ready" 2 ) ( not ( is-destroyed-delay 0 "Aster" ) ) ) ( send-message "Aster" "High" "C Jump" ) )
+Name: Say C Jump
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Drive Ready" 8 ) ( do-nothing ) )
+Name: Convoy Jump
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( and ( has-departed-delay 2 "Aster" ) ( has-departed-delay 2 "Tern" ) ( has-departed-delay 2 "Briony" ) ) ( send-message "#Command" "High" "C Win" ) )
+Name: Win
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Win" 7 ) ( fade-out 1000 ) )
+Name: Fade out
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fade out" 2 ) ( end-mission ) )
+Name: Finish
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Aster" ) ( send-message "#Command" "High" "C Lost" ) )
+Name: Aster Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Tern" ) ( send-message "#Command" "High" "C Lost" ) )
+Name: Tern Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Briony" ) ( send-message "#Command" "High" "C Lost" ) )
+Name: Briony Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-destroyed-delay 1 "Halyard" ) ( send-message "#Command" "High" "C Lost" ) )
+Name: Halyard Lost
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( or ( is-event-true-delay "Aster Lost" 8 ) ( is-event-true-delay "Tern Lost" 8 ) ( is-event-true-delay "Briony Lost" 8 ) ( is-event-true-delay "Halyard Lost" 8 ) ) ( fade-out 1000 ) )
+Name: Fail Fade
+Repeat Count: 1
+Interval: 1

$Formula: ( when ( is-event-true-delay "Fail Fade" 2 ) ( end-mission ) )
+Name: Fail End
+Repeat Count: 1
+Interval: 1

