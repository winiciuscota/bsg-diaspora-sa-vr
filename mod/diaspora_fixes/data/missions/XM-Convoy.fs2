$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("Every ship of the convoy reached the jump point. Twenty-two minutes of escort and six waves of Cylons, and nobody was lost.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Meet the Heavy Raiders early, they do all the damage to slow ships.", -1)
$end_multi_text

$Formula: ( or ( is-event-true-delay "Aster Lost" 0 ) ( is-event-true-delay "Tern Lost" 0 ) ( is-event-true-delay "Briony Lost" 0 ) ( is-event-true-delay "Halyard Lost" 0 ) )
$Multi text
    XSTR("A civilian ship went down on the lane. The convoy's loss is on all of us.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Stay with the convoy rather than chasing Raiders, and kill the Heavies on every wave.", -1)
$end_multi_text

