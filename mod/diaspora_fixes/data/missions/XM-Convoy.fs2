#Messages		;! 14 total

$Command Sender: Theseus

$Name: C Orders
$Team: -1
$MessageNew:  XSTR("Red flight, the convoy has twenty-two minutes to make the jump point, nine hundred metres a minute no faster. Halyard rides with it. Keep every ship alive.", -1)
$end_multi_text
+Wave Name: XM-Convoy-01.ogg

$Name: C Aster
$Team: -1
$MessageNew:  XSTR("Aster here, four hundred and twelve aboard. We were told this would be quiet.", -1)
$end_multi_text
+Wave Name: XM-Convoy-02.ogg

$Name: C Tern
$Team: -1
$MessageNew:  XSTR("Tern, loaded to the gunwales with medical supplies. We'll stay on the lane, Red leader.", -1)
$end_multi_text
+Wave Name: XM-Convoy-03.ogg

$Name: C Hawk
$Team: -1
$MessageNew:  XSTR("Four Raiders from the port beam. They're after the cruiser.", -1)
$end_multi_text
+Wave Name: XM-Convoy-04.ogg

$Name: C Mauler
$Team: -1
$MessageNew:  XSTR("Heavy Raiders on the stern! Red flight, they have torpedoes!", -1)
$end_multi_text
+Wave Name: XM-Convoy-05.ogg

$Name: C Pincer
$Team: -1
$MessageNew:  XSTR("Advanced Raiders from both flanks, they're trying to pincer us.", -1)
$end_multi_text
+Wave Name: XM-Convoy-06.ogg

$Name: C Blue
$Team: -1
$MessageNew:  XSTR("Ghost and Rook, joining from the fleet. Sorry we're late, Red leader.", -1)
$end_multi_text
+Wave Name: XM-Convoy-07.ogg

$Name: C Basestar
$Team: -1
$MessageNew:  XSTR("DRADIS, basestar dead ahead! They set a trap at the jump point. Convoy, keep your course.", -1)
$end_multi_text
+Wave Name: XM-Convoy-08.ogg

$Name: C Briony
$Team: -1
$MessageNew:  XSTR("Briony, we're taking fire on the starboard side! Please hurry!", -1)
$end_multi_text
+Wave Name: XM-Convoy-09.ogg

$Name: C Talon
$Team: -1
$MessageNew:  XSTR("Four more Heavies, they want Aster. Everything we have on them!", -1)
$end_multi_text
+Wave Name: XM-Convoy-10.ogg

$Name: C Dust
$Team: -1
$MessageNew:  XSTR("Last wave, five Advanced Raiders, all at once. Don't let anyone through!", -1)
$end_multi_text
+Wave Name: XM-Convoy-11.ogg

$Name: C Jump
$Team: -1
$MessageNew:  XSTR("Jump point in range! Spooling now, ten seconds. Thank you all.", -1)
$end_multi_text
+Wave Name: XM-Convoy-12.ogg

$Name: C Win
$Team: -1
$MessageNew:  XSTR("The convoy is through, four hundred and twelve passengers and the whole medical shipment. A long, cold run and you did it well.", -1)
$end_multi_text
+Wave Name: XM-Convoy-13.ogg

$Name: C Lost
$Team: -1
$MessageNew:  XSTR("We lost a ship of the convoy. Break off, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Convoy-14.ogg

