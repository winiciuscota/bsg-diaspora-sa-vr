#Debriefing_info

$Num stages: 2

$Formula: ( is-event-true-delay "Win" 0 )
$Multi text
    XSTR("The Halyard brought her flock home. Commander Ostrava sends her thanks and says her gunners owe Red flight a round. The Tessaly belt is a little quieter tonight.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("Drive the Raiders into the Halyard's flak. A frigate's guns do a lot of the work if you let them.", -1)
$end_multi_text

$Formula: ( or ( is-event-true-delay "Halyard Lost" 0 ) ( is-event-true-delay "Both Liners Lost" 0 ) )
$Multi text
    XSTR("The flock never reached the fleet. We'll be counting the cost of the Tessaly belt for a long time.", -1)
$end_multi_text
$Voice: none
$Recommendation text:
    XSTR("The Heavy Raiders arrive last and go for the frigate. Have missiles left for them.", -1)
$end_multi_text

#Callsigns:
$Callsign: Shadow
$Callsign: Flask

#end


