$Command Sender: Theseus

$Name: HQ Orders
$Team: -1
$MessageNew:  XSTR("Red flight, Theseus. Halyard is bringing two liners through the Tessaly belt. Stay with her. The Cylons like to hunt in the rocks.", -1)
$end_multi_text
+Wave Name: XM-Shepherd-01.ogg

$Name: Halyard Hail
$Team: -1
$MessageNew:  XSTR("Red Leader, Commander Ostrava, Halyard. My flak will keep anything big off us, but Raiders are too quick for my gunners. Keep them off the liners and I'll handle the rest.", -1)
$end_multi_text
+Wave Name: XM-Shepherd-02.ogg

$Name: S Wolves
$Team: -1
$MessageNew:  XSTR("Raiders out of the rocks, they're going for the Aster!", -1)
$end_multi_text
+Wave Name: XM-Shepherd-03.ogg

$Name: Halyard Flak
$Team: -1
$MessageNew:  XSTR("Halyard, all batteries, flak barrage on my port side. Red flight, drive them into it!", -1)
$end_multi_text
+Wave Name: XM-Shepherd-04.ogg

$Name: F Jackals
$Team: -1
$MessageNew:  XSTR("Second group, advanced models on the Briony! I'm on them.", -1)
$end_multi_text
+Wave Name: XM-Shepherd-05.ogg

$Name: S Rams
$Team: -1
$MessageNew:  XSTR("Heavy Raiders ahead, lining up on the Halyard!", -1)
$end_multi_text
+Wave Name: XM-Shepherd-06.ogg

$Name: Halyard Torps
$Team: -1
$MessageNew:  XSTR("They're making torpedo runs on us. I can take a few hits, but kill those Heavies!", -1)
$end_multi_text
+Wave Name: XM-Shepherd-07.ogg

$Name: Halyard Jump
$Team: -1
$MessageNew:  XSTR("Jump point reached. Flock, on my coordinates. Red flight, thank you, we'll see you at the fleet.", -1)
$end_multi_text
+Wave Name: XM-Shepherd-08.ogg

$Name: HQ Win
$Team: -1
$MessageNew:  XSTR("Halyard and both liners are clear. Nine hundred people just reached the fleet. Good work, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Shepherd-09.ogg

$Name: HQ Liner Lost
$Team: -1
$MessageNew:  XSTR("We've lost one of the liners. Gods. Keep the other one alive, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Shepherd-10.ogg

$Name: HQ Halyard Lost
$Team: -1
$MessageNew:  XSTR("Halyard is gone. Without her the liners don't stand a chance. Break off, Red flight.", -1)
$end_multi_text
+Wave Name: XM-Shepherd-11.ogg

